---
import { produce } from '../data/site';
---

<section id="produce" class="relative bg-green-950 text-white" aria-labelledby="produce-title" data-produce>
  <div class="container-x pb-10 pt-24 md:pt-32">
    <div class="grid gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="eyebrow text-lime" data-reveal>Mahela produce</p>
        <h2 id="produce-title" class="font-display mt-5 text-h2 font-light" data-split>A diversified fruit portfolio. Citrus at the core.</h2>
      </div>
      <p class="text-lg leading-relaxed text-white/70 md:col-span-5" data-reveal>
        Tried-and-tested orchard management and the Lowveld’s warm days and cool nights support fruit with balanced sugar and acidity, good fibre and moisture, and the consistency international buyers expect.
      </p>
    </div>
  </div>

  <div class="container-x pb-24 md:pb-32">
    <ol class="space-y-5 md:space-y-0">
      {
        produce.map((p, i) => (
          <li
            id={p.slug}
            class="produce-panel group relative grid gap-6 overflow-hidden rounded-3xl md:min-h-[78vh] md:grid-cols-12 md:items-center md:rounded-none md:border-t md:border-white/10 md:py-16"
            data-tone={p.tone[1]}
          >
            <div class="relative aspect-[4/3] overflow-hidden rounded-3xl md:col-span-6 md:aspect-[5/4]">
              <div
                class="ph absolute inset-0 transition-transform duration-[1.4s] ease-out-expo group-hover:scale-[1.03]"
                style={`--ph-a:${p.tone[0]};--ph-b:${p.tone[1]}`}
                data-label={`Photo: ${p.name.toLowerCase()} cut-out (2026 set)`}
                data-mask
              />
              <span class="font-display tabular absolute right-5 top-4 text-6xl font-light text-white/25">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="px-5 pb-8 md:col-span-5 md:col-start-8 md:px-0 md:pb-0">
              <p class="eyebrow text-lime">{p.tag}</p>
              <h3 class="font-display mt-4 text-[clamp(2.25rem,1.6rem+2.4vw,4rem)] font-light leading-none">{p.name}</h3>
              <p class="mt-6 text-base leading-relaxed text-white/75 md:text-lg">{p.summary}</p>
              <ul class="mt-6 flex flex-wrap gap-2">
                {p.facts.map((f) => (
                  <li class="rounded-full border border-white/15 px-3 py-1.5 text-xs text-white/80">{f}</li>
                ))}
              </ul>
              <a href={`/produce/${p.slug}`} class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-white">
                <span class="border-b border-lime pb-0.5">Explore {p.name.toLowerCase()}</span>
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
