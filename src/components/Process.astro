---
import { process } from '../data/site';
---

<section class="bg-bone py-24 md:py-36" aria-labelledby="process-title">
  <div class="container-x">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="eyebrow text-green-700" data-reveal>{process.eyebrow}</p>
        <h2 id="process-title" class="font-display mt-5 text-h2 font-light text-green-950" data-split>{process.title}</h2>
      </div>
      <p class="text-lg leading-relaxed text-ink-soft md:col-span-6 md:col-start-7 md:pt-12" data-reveal>{process.lead}</p>
    </div>

    <ol class="relative mt-20 grid gap-px overflow-hidden rounded-3xl bg-line md:grid-cols-5" data-process>
      <span class="absolute left-0 top-0 hidden h-[3px] w-full origin-left scale-x-0 bg-lime md:block" data-process-line aria-hidden="true"></span>
      {
        process.steps.map((s, i) => (
          <li class="flex flex-col bg-bone p-7 md:min-h-[320px] md:p-8" data-reveal>
            <span class="font-display tabular text-5xl font-light text-green-700/40">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-auto pt-10 text-lg font-semibold text-green-950">{s.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-soft">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
