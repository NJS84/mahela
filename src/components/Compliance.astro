---
import { Image } from 'astro:assets';
import { compliance } from '../data/site';
import globalgap from '../assets/media/certifications/globalgap-colour.png';
import siza from '../assets/media/certifications/siza-colour.png';
import nsf from '../assets/media/certifications/nsf-registered-colour.png';

const logos: Record<string, ImageMetadata> = { GlobalGAP: globalgap, SIZA: siza, 'NSF Registered': nsf };
---

<section class="relative overflow-hidden bg-brand text-white" aria-labelledby="compliance-title">
  <div class="pointer-events-none absolute -left-40 top-1/2 size-[720px] -translate-y-1/2 rounded-full border border-white/10" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-20 top-1/2 size-[520px] -translate-y-1/2 rounded-full border border-white/10" aria-hidden="true"></div>

  <div class="container-x relative py-24 md:py-36">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow text-lime" data-reveal>{compliance.eyebrow}</p>
        <h2 id="compliance-title" class="font-display mt-5 text-h2 font-light" data-split>{compliance.title}</h2>
        <p class="mt-8 max-w-md text-lg leading-relaxed text-white/75" data-reveal>{compliance.lead}</p>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
        {
          compliance.pillars.map((p, i) => (
            <li class="tilt-card rounded-3xl border border-white/15 bg-white/[0.04] p-7 backdrop-blur-sm md:p-8" data-reveal data-tilt>
              <span class="eyebrow text-lime/80">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-8 text-xl font-semibold">{p.title}</h3>
              <p class="mt-3 leading-relaxed text-white/70">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-20 border-t border-white/15 pt-10" data-reveal>
      <p class="eyebrow text-white/50">Certifications &amp; memberships</p>
      <div class="marquee mt-6 overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_10%,#000_90%,transparent)]">
        <ul class="marquee-track flex w-max gap-4">
          {
            [...compliance.memberships, ...compliance.memberships].map((m, i) => (
              <li class:list={['flex h-20 w-52 items-center justify-center rounded-2xl px-6 text-sm font-semibold tracking-wide', logos[m] ? 'bg-white text-ink' : 'border border-white/15 text-white/80']} aria-hidden={i >= compliance.memberships.length ? 'true' : undefined}>
                {logos[m] ? <Image src={logos[m]} alt={m} height={48} class="max-h-10 w-auto object-contain" /> : m}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: marquee 40s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
    }
  }
</style>
