---
import { heritage } from '../data/site';
---

<section class="relative overflow-hidden bg-green-900 text-white" aria-labelledby="heritage-title" data-heritage>
  <div class="flex flex-col md:h-[100svh] md:justify-center">
    <div class="container-x pt-24 md:pt-0">
      <p class="eyebrow text-lime" data-reveal>{heritage.eyebrow}</p>
      <h2 id="heritage-title" class="font-display mt-5 max-w-3xl text-h2 font-light" data-split>{heritage.title}</h2>
    </div>
    <div class="mt-14 overflow-x-auto pb-24 md:pb-10" data-heritage-scroll>
      <ol class="container-x flex flex-col gap-10 md:w-max md:max-w-none md:flex-row md:gap-0 md:pr-[30vw]" data-heritage-track>
        {
          heritage.milestones.map((m) => (
            <li class="relative border-l border-white/20 pl-6 md:w-[26rem] md:border-l-0 md:border-t md:pl-0 md:pr-12 md:pt-8">
              <span class="absolute -left-[5px] top-1 size-[9px] rounded-full bg-lime md:-top-[5px] md:left-0" aria-hidden="true" />
              <p class="font-display tabular text-[clamp(2.5rem,1.8rem+2.5vw,4.5rem)] font-light leading-none text-lime">{m.year}</p>
              <p class="mt-5 max-w-sm leading-relaxed text-white/75">{m.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
