---
import { intro, metrics } from '../data/site';
const fmt = (n: number) => n.toLocaleString('en-ZA').replace(/,/g, ' ');
---

<section class="bg-bone py-24 md:py-36" aria-labelledby="intro-title">
  <div class="container-x">
    <div class="grid gap-12 md:grid-cols-12">
      <p class="eyebrow text-green-700 md:col-span-3" data-reveal>{intro.eyebrow}</p>
      <div class="md:col-span-9">
        <h2 id="intro-title" class="font-display text-h2 font-light text-green-950" data-split>{intro.text}</h2>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink-soft" data-reveal>{intro.support}</p>
      </div>
    </div>

    <dl class="mt-20 grid grid-cols-2 border-t border-line md:mt-28 md:grid-cols-3 lg:grid-cols-6">
      {
        metrics.map((m) => (
          <div class="flex flex-col-reverse justify-end border-b border-line py-8 pr-4lg:border-b-0 lg:border-r lg:px-5 lg:first:pl-0 lg:last:border-r-0" data-reveal>
            <dt class="mt-3text-sm leading-snug text-ink-soft">{m.label}</dt>
            <dd class="font-display tabular text-[clamp(1.9rem,1.4rem+1.6vw,2.9rem)] font-light leading-none text-green-900">
              {m.prefix && <span class="block pb-1 font-sans text-xs font-semibold uppercase tracking-[0.14em] text-green-700">{m.prefix}</span>}
              <span data-count={m.value} data-format={m.format ?? 'number'}>
                {m.format === 'year' ? m.value : fmt(m.value)}
              </span>
              {m.suffix && <span class="text-[0.6em]">{m.suffix}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
