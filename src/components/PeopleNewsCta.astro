---
import { Image } from 'astro:assets';
import { people, news, cta, site } from '../data/site';
import team from '../assets/media/people/dhk-9884.jpg';
---

<section class="bg-bone py-24 md:py-36" aria-labelledby="people-title">
  <div class="container-x grid gap-12 md:grid-cols-12 md:items-center">
    <div class="relative aspect-[4/5] overflow-hidden rounded-3xl md:col-span-6" data-reveal>
      <div class="absolute inset-[-8%]" data-parallax="0.12">
        <Image src={team} alt="Mahela Group directors walking through an orchard" widths={[600, 900, 1200]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover object-[45%_50%]" />
      </div>
    </div>
    <div class="md:col-span-5 md:col-start-8">
      <p class="eyebrow text-green-700" data-reveal>{people.eyebrow}</p>
      <h2 id="people-title" class="font-display mt-5 text-h2 font-light text-green-950" data-split>{people.title}</h2>
      <p class="mt-8 text-lg leading-relaxed text-ink-soft" data-reveal>{people.text}</p>
      <a href={people.cta.href} class="mt-10 inline-flex items-center gap-2 rounded-full bg-green-700 px-6 py-3.5 font-semibold text-white transition-transform duration-300 hover:-translate-y-0.5" data-reveal>
        {people.cta.label} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<section class="border-t border-line bg-bone pb-24 pt-20 md:pb-36" aria-labelledby="news-title">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow text-green-700" data-reveal>Mahela news</p>
        <h2 id="news-title" class="font-display mt-4 text-h3 font-light text-green-950 md:text-h2" data-reveal>South African agri &amp; export news</h2>
      </div>
      <a href="/news" class="text-sm font-semibold text-green-800" data-reveal><span class="border-b border-green-700 pb-0.5">All news</span> →</a>
    </div>
    <ul class="mt-12 grid gap-px overflow-hidden rounded-3xl bg-line md:grid-cols-3">
      {
        news.map((n) => (
          <li class="group bg-bone" data-reveal>
            <a href={n.href} class="flex h-full flex-col p-7 transition-colors hover:bg-white md:min-h-[260px] md:p-8">
              <span class="eyebrow text-ink-soft/70">{n.source}</span>
              <h3 class="font-display mt-auto pt-12 text-2xl font-light leading-snug text-green-950">{n.title}</h3>
              <span class="mt-6 text-sm font-semibold text-green-700">Read article <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="relative overflow-hidden bg-green-700 text-white" aria-labelledby="cta-title">
  <div class="pointer-events-none absolute -right-24 -top-24 size-[480px] rounded-full bg-lime/20 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative grid gap-12 py-24 md:grid-cols-12 md:items-end md:py-32">
    <div class="md:col-span-7">
      <p class="eyebrow text-lime" data-reveal>{cta.eyebrow}</p>
      <h2 id="cta-title" class="font-display mt-5 text-h2 font-light" data-split>{cta.title}</h2>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-white/80" data-reveal>{cta.text}</p>
    </div>
    <div class="flex flex-col gap-3 md:col-span-4 md:col-start-9" data-reveal>
      <a href={cta.primary.href} class="inline-flex items-center justify-between rounded-full bg-lime px-7 py-4 font-semibold text-green-950 transition-transform duration-300 hover:-translate-y-0.5">
        {cta.primary.label} <span aria-hidden="true">→</span>
      </a>
      <a href={site.phoneHref} class="inline-flex items-center justify-between rounded-full border border-white/30 px-7 py-4 font-medium transition-colors hover:bg-white/10">
        Call {site.phone} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
