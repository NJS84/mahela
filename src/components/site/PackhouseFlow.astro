---
/**
 * Packhouses scroll scene: "Follow the fruit". The section pins while you scroll. Each stage's
 * photo fills the screen; an orange rolls along a conveyor track at the bottom past six stations
 * (orchard to market), and the next photo opens as a circle out of the orange. A blue glass card
 * carries the approved journey text for the stage.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { IconName } from '../../lib/icons';
import { media } from '../../lib/media';

interface Props {
  steps: { title: string; text: string; icon: string; photo: string; alt: string; pos?: string }[];
}
const { steps } = Astro.props;
const orange = media('produce/renders/orange.webp');
const n = steps.length;
---

<section class="pf relative isolate bg-[#0d1a2c]" style={`height:${n * 70 + 60}svh`} aria-labelledby="pf-title" data-pf>
  <div class="sticky top-0 h-[100svh] overflow-hidden">
    <!-- Full-screen photo stack -->
    <div class="absolute inset-0 -z-10">
      {steps.map((s, i) => (
        <figure class="absolute inset-0 overflow-hidden" style={i === 0 ? '' : 'clip-path:circle(0% at 50% 90%)'} data-pf-photo={i}>
          <Image src={media(s.photo)} alt={s.alt} widths={[768, 1280, 1920]} sizes="100vw" class="h-full w-full object-cover" style={s.pos ? `object-position:${s.pos}` : ''} />
        </figure>
      ))}
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(8_18_34/0.7)_0%,rgb(8_18_34/0.15)_35%,rgb(8_18_34/0.25)_60%,rgb(8_18_34/0.88)_100%)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgb(8_18_34/0.55),transparent_55%)]"></div>
    </div>

    <div class="relative mx-auto flex h-full w-full max-w-[84rem] flex-col px-4 pb-6 pt-24 md:px-6 md:pb-10 md:pt-28">
      <div>
        <span class="text-xs font-semibold uppercase tracking-[0.22em] text-white/80">Orchard to port</span>
        <h2 id="pf-title" class="cond mt-3 text-[clamp(2.2rem,1.5rem+2.4vw,3.8rem)] font-medium uppercase leading-[0.95] text-white drop-shadow-[0_4px_24px_rgba(0,0,0,0.4)]">Follow the fruit</h2>
      </div>

      <!-- Stage card -->
      <div class="relative mt-auto mb-8 h-[11.5rem] max-w-md md:mb-12 md:h-[12rem]">
        {steps.map((s, i) => (
          <article class="pf-card absolute inset-x-0 bottom-0 rounded-[24px] p-5 md:p-6" data-pf-card={i} style={i === 0 ? '' : 'opacity:0;visibility:hidden'}>
            <div class="flex items-center gap-3">
              <span class="flex size-10 items-center justify-center rounded-full bg-[#74c365] text-white shadow-[0_0_0_5px_rgb(116_195_101/0.25)]"><Icon name={s.icon as IconName} class="size-5" /></span>
              <span class="text-[0.66rem] font-bold uppercase tracking-[0.18em] text-white/75">{String(i + 1).padStart(2, '0')} / {String(n).padStart(2, '0')}</span>
            </div>
            <h3 class="cond mt-3 text-2xl font-medium uppercase leading-none tracking-[0.03em] text-white md:text-3xl">{s.title}</h3>
            <p class="mt-2 text-[0.92rem] leading-snug text-white/85">{s.text}</p>
          </article>
        ))}
      </div>

      <!-- Conveyor track with stations -->
      <div class="relative" data-pf-track>
        <div class="pf-belt relative h-4 rounded-full md:h-5" aria-hidden="true">
          <div class="pf-rollers absolute inset-0 rounded-full" data-pf-rollers></div>
          <div class="pf-fill absolute inset-y-0 left-0 rounded-full" style="width:0" data-pf-fill></div>
        </div>
        <ol class="relative mt-3 grid" style={`grid-template-columns:repeat(${n},minmax(0,1fr))`}>
          {steps.map((s, i) => (
            <li class="pf-step flex flex-col items-center text-center" data-pf-step={i}>
              <span class="pf-node -mt-[2.05rem] flex size-6 items-center justify-center rounded-full md:-mt-[2.3rem] md:size-7" aria-hidden="true"><Icon name={s.icon as IconName} class="size-3 md:size-3.5" /></span>
              <span class="pf-label mt-2 text-[0.58rem] font-semibold uppercase tracking-[0.12em] md:text-[0.7rem]">{s.title}</span>
            </li>
          ))}
        </ol>
        <div class="pointer-events-none absolute left-0 top-0 z-10 -translate-x-1/2" style="margin-top:-1.55rem" aria-hidden="true" data-pf-orange>
          <Image src={orange} alt="" widths={[160]} sizes="64px" class="size-12 drop-shadow-[0_10px_16px_rgba(0,0,0,0.55)] md:size-16" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pf-card,
  .pf-belt {
    background: linear-gradient(160deg, rgb(150 190 240 / 0.28), rgb(60 110 180 / 0.16));
    border: 1px solid rgb(225 238 255 / 0.35);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.3), 0 30px 60px -30px rgb(0 0 0 / 0.6);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    backdrop-filter: blur(18px) saturate(150%);
  }
  .pf-rollers {
    background-image: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.22) 0 2px, transparent 2px 16px);
    opacity: 0.8;
  }
  .pf-fill {
    background: linear-gradient(90deg, #74c365, #f59a23);
    box-shadow: 0 0 16px rgb(245 154 35 / 0.55);
    opacity: 0.85;
  }
  .pf-node {
    color: rgb(255 255 255 / 0.75);
    background: #10243d;
    border: 1px solid rgb(255 255 255 / 0.35);
    transition: background-color 0.4s, border-color 0.4s, color 0.4s, box-shadow 0.4s;
  }
  .pf-step.is-on .pf-node,
  .pf-step.is-past .pf-node {
    color: #fff;
    background: #74c365;
    border-color: #fff;
    box-shadow: 0 0 0 4px rgb(116 195 101 / 0.25);
  }
  .pf-label {
    color: rgb(255 255 255 / 0.55);
    transition: color 0.4s;
  }
  .pf-step.is-on .pf-label {
    color: #fff;
  }
  @media (max-width: 639px) {
    .pf-label {
      opacity: 0;
      transition: opacity 0.4s;
    }
    .pf-step.is-on .pf-label {
      opacity: 1;
      white-space: nowrap;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll<HTMLElement>('[data-pf]').forEach((root) => {
    const photos = [...root.querySelectorAll<HTMLElement>('[data-pf-photo]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-pf-card]')];
    const steps = [...root.querySelectorAll<HTMLElement>('[data-pf-step]')];
    const track = root.querySelector<HTMLElement>('[data-pf-track]')!;
    const fill = root.querySelector<HTMLElement>('[data-pf-fill]')!;
    const rollers = root.querySelector<HTMLElement>('[data-pf-rollers]')!;
    const orange = root.querySelector<HTMLElement>('[data-pf-orange]')!;
    const sticky = root.firstElementChild as HTMLElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const n = steps.length;
    let at = 0;
    steps[0]!.classList.add('is-on');

    /** x of station k's node, relative to the track. */
    const nodeX = (k: number) => {
      const node = steps[k]!.querySelector<HTMLElement>('.pf-node')!;
      const r = node.getBoundingClientRect();
      return r.left + r.width / 2 - track.getBoundingClientRect().left;
    };

    const show = (i: number) => {
      if (i === at) return;
      const from = at;
      at = i;
      steps.forEach((s, k) => {
        s.classList.toggle('is-on', k === i);
        s.classList.toggle('is-past', k < i);
      });
      // The new photo opens as a circle out of the orange.
      const o = orange.getBoundingClientRect();
      const box = sticky.getBoundingClientRect();
      const cx = ((o.left + o.width / 2 - box.left) / box.width) * 100;
      const cy = ((o.top + o.height / 2 - box.top) / box.height) * 100;
      photos.forEach((p, k) => {
        if (k === i) {
          gsap.set(p, { zIndex: 2 });
          gsap.fromTo(p, { clipPath: `circle(0% at ${cx}% ${cy}%)` }, { clipPath: `circle(150% at ${cx}% ${cy}%)`, duration: reduce ? 0 : 1.1, ease: 'power2.inOut' });
          gsap.fromTo(p.firstElementChild, { scale: 1.12 }, { scale: 1, duration: reduce ? 0 : 1.6, ease: 'power2.out' });
        } else gsap.set(p, { zIndex: k === from ? 1 : 0, clipPath: k === from ? 'circle(150% at 50% 50%)' : 'circle(0% at 50% 90%)' });
      });
      cards.forEach((c, k) => {
        if (k === i) gsap.fromTo(c, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: reduce ? 0 : 0.6, ease: 'power3.out', overwrite: true });
        else gsap.to(c, { autoAlpha: 0, y: -16, duration: reduce ? 0 : 0.35, ease: 'power2.in', overwrite: true });
      });
    };

    ScrollTrigger.create({
      trigger: root,
      start: 'top top',
      end: 'bottom bottom',
      scrub: true,
      invalidateOnRefresh: true,
      onUpdate: (st) => {
        const p = st.progress;
        const i = Math.min(n - 1, Math.floor(p * n * 0.999));
        const local = Math.min(1, p * n - i);
        // Roll to the next station in the second half of each stage, rest while it reads.
        const t = i < n - 1 ? gsap.parseEase('power2.inOut')(Math.max(0, (local - 0.5) / 0.5)) : 0;
        const x0 = nodeX(i);
        const x1 = i < n - 1 ? nodeX(i + 1) : x0;
        const x = x0 + (x1 - x0) * t;
        const size = orange.offsetWidth || 56;
        // Rotation follows the distance rolled: angle = distance / radius.
        gsap.set(orange, { x, rotation: (x / (size / 2)) * (180 / Math.PI) });
        gsap.set(fill, { width: x });
        gsap.set(rollers, { backgroundPositionX: -x * 1.5 });
        // Switch stage as the orange arrives.
        show(t > 0.92 ? Math.min(n - 1, i + 1) : i);
      },
    });
    gsap.set(orange, { x: nodeX(0) });
    ScrollTrigger.addEventListener('refresh', () => gsap.set(orange, { x: nodeX(at) }));
  });
</script>
