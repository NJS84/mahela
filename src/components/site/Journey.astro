---
/**
 * Farm-to-port journey: a line draws down the page as you scroll and a carton
 * travels along it; each stop lights up as it is reached.
 */
import Icon from './Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  steps: { title: string; text: string; icon?: IconName }[];
}
const { steps } = Astro.props;
const n = steps.length;
const H = n * 100;
// A gentle S-curve down the centre column (viewBox 0 0 100 H)
let d = 'M50 0';
for (let i = 0; i < n; i++) {
  const y0 = i * 100;
  const dir = i % 2 === 0 ? 1 : -1;
  d += ` C ${50 + dir * 38} ${y0 + 30}, ${50 + dir * 38} ${y0 + 70}, 50 ${y0 + 100}`;
}
---

<div class="relative" data-journey>
  <svg class="pointer-events-none absolute left-1/2 top-0 hidden h-full w-40 -translate-x-1/2 md:block" viewBox={`0 0 100 ${H}`} preserveAspectRatio="none" aria-hidden="true">
    <path d={d} fill="none" stroke="rgb(245 242 234 / 0.15)" stroke-width="2" vector-effect="non-scaling-stroke"></path>
    <path d={d} fill="none" stroke="#b9d1a6" stroke-width="2.5" vector-effect="non-scaling-stroke" data-journey-path></path>
  </svg>
  <div class="pointer-events-none absolute left-1/2 top-0 z-10 hidden h-full w-40 -translate-x-1/2 md:block" aria-hidden="true">
    <span class="absolute left-0 top-0 flex size-12 items-center justify-center rounded-2xl border border-ivory/30 bg-[#f07d14] text-ivory shadow-[0_10px_30px_rgba(240,125,20,0.5)]" data-journey-mover>
      <Icon name="box" class="size-6" />
    </span>
  </div>
  <ol class="relative grid gap-6 md:gap-0">
    {
      steps.map((s, i) => (
        <li class:list={['journey-stop md:grid md:min-h-[17rem] md:grid-cols-2 md:items-center md:gap-40']} data-stop>
          <div class:list={['glass rounded-[26px] p-7 transition-all duration-700', i % 2 === 0 ? 'md:col-start-1' : 'md:col-start-2']} data-glare>
            <div class="flex items-center gap-4">
              <span class="cond text-4xl font-semibold text-sage/70 tabular">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex size-12 items-center justify-center rounded-full border border-ivory/30 bg-forest/50">
                <Icon name={s.icon ?? 'leaf'} class="size-6" />
              </span>
            </div>
            <h3 class="cond mt-4 text-2xl font-medium uppercase tracking-[0.05em]">{s.title}</h3>
            <p class="mt-2 leading-relaxed text-ivory/80">{s.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  :global(.js-motion) .journey-stop > div {
    opacity: 0.35;
    transform: scale(0.96);
  }
  :global(.js-motion) .journey-stop:global(.is-on) > div {
    opacity: 1;
    transform: none;
  }
</style>
