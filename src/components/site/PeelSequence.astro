---
/**
 * Pinned scroll sequence: an orange peels and opens into segments as you
 * scroll, with captions from the approved citrus copy. Frames crossfade
 * (they were shot separately, so they are not registered frame to frame).
 */
import { Image } from 'astro:assets';
import { media } from '../../lib/media';

const frames = [
  { img: 'produce/renders/orange.webp', title: 'Grown in the Lowveld', text: 'Warm days and cold nights in our region.' },
  { img: 'produce/renders/peel-1.webp', title: 'Balanced', text: 'Well-balanced levels of sugar and acidity.' },
  { img: 'produce/renders/peel-2.webp', title: 'Juicy', text: 'Good fibre and moisture content.' },
  { img: 'produce/renders/peel-3.webp', title: 'Easy to enjoy', text: 'Easy-peelers, seedless navels and juicing oranges.' },
  { img: 'produce/renders/segments-exploded.webp', title: 'Five citrus groups', text: 'Grapefruit, Valencia oranges, navels, soft citrus and lemons.' },
];
---

<section class="peel relative" aria-label="Inside a Mahela orange" data-peel>
  <div class="peel-stage sticky top-0 flex h-[100svh] items-center overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(55%_55%_at_60%_50%,rgb(232_116_42/0.35),transparent_70%),#10201a]"></div>
    <Image src={media('generated/juice-splash.jpg')} alt="" widths={[800, 1024]} sizes="60vw" class="peel-splash pointer-events-none absolute left-1/2 top-1/2 -z-10 w-[min(70vw,760px)] -translate-x-1/2 -translate-y-1/2 opacity-0 mix-blend-screen [mask-image:radial-gradient(closest-side,#000_55%,transparent)]" />
    <div class="mx-auto grid w-full max-w-[84rem] items-center gap-8 px-4 md:px-6 lg:grid-cols-12">
      <ol class="relative order-2 min-h-[9rem] lg:order-1 lg:col-span-4">
        {
          frames.map((f, i) => (
            <li class="peel-cap absolute inset-x-0 top-0" data-peel-cap style={i === 0 ? '' : 'opacity:0'}>
              <p class="cond text-sm font-semibold text-sage">{String(i + 1).padStart(2, '0')} / 05</p>
              <h3 class="cond mt-2 text-[clamp(2.2rem,1.5rem+2.4vw,4rem)] font-medium uppercase leading-[0.95]">{f.title}</h3>
              <p class="mt-3 max-w-sm text-lg text-ivory/80">{f.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="relative order-1 mx-auto aspect-square w-[min(78vw,560px)] lg:order-2 lg:col-span-8" aria-hidden="true">
        {
          frames.map((f, i) => (
            <Image src={media(f.img)} alt="" widths={[480, 720, 960]} sizes="(min-width: 1024px) 560px, 78vw" class="peel-frame absolute inset-0 h-full w-full object-contain drop-shadow-[0_40px_50px_rgba(0,0,0,0.5)]" style={i === 0 ? '' : 'opacity:0'} data-peel-frame />
          ))
        }
      </div>
    </div>
    <div class="absolute bottom-8 left-1/2 h-1 w-40 -translate-x-1/2 overflow-hidden rounded-full bg-ivory/15" aria-hidden="true"><span class="block h-full w-full origin-left scale-x-0 bg-sage" data-peel-bar></span></div>
  </div>
</section>

<style>
  .peel {
    height: 420svh;
  }
  :global(html:not(.js-motion)) .peel {
    height: auto;
  }
  :global(html:not(.js-motion)) .peel-stage {
    position: relative;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  if (document.documentElement.classList.contains('js-motion')) {
    document.querySelectorAll<HTMLElement>('[data-peel]').forEach((root) => {
      const frames = root.querySelectorAll<HTMLElement>('[data-peel-frame]');
      const caps = root.querySelectorAll<HTMLElement>('[data-peel-cap]');
      const n = frames.length;
      const tl = gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: { trigger: root, start: 'top top', end: 'bottom bottom', scrub: 0.5 } });
      tl.to(root.querySelector('[data-peel-bar]'), { scaleX: 1, duration: n - 1 }, 0);
      gsap.set(frames, { transformOrigin: '50% 50%' });
      for (let i = 1; i < n; i++) {
        const at = i - 0.6;
        tl.to(frames[i - 1]!, { opacity: 0, scale: 1.08, rotate: i % 2 ? -6 : 6, duration: 0.5 }, at)
          .fromTo(frames[i]!, { opacity: 0, scale: 0.9, rotate: i % 2 ? 6 : -6 }, { opacity: 1, scale: 1, rotate: 0, duration: 0.5 }, at)
          .to(caps[i - 1]!, { opacity: 0, y: -30, duration: 0.3 }, at)
          .fromTo(caps[i]!, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.3 }, at + 0.2);
      }
      tl.to(root.querySelector('.peel-splash'), { opacity: 0.9, scale: 1.25, duration: 0.6 }, n - 1.6);
    });
  }
</script>
