---
/**
 * Bananas: the Cavendish story in one section, in the same pattern as the citrus and avocado pages.
 * Left: a big bunch in a glass ring, the variety name and a glass panel with the harvest split
 * (two-thirds in summer, the rest in winter) and the bio-fertiliser note. Right: three square
 * blue-tinted glass cards, one in view at a time (arrows, click or swipe), with icons in a row below.
 * The left fruit and the section colour change with each card.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { media } from '../../lib/media';
import { bananaCards } from '../../data/banana';

const arts = ['produce/renders/banana.webp', 'produce/renders/banana-green.webp', 'produce/cutouts/banana-peeled.webp'].map((p) => media(p));
const cs = bananaCards.map((c, i) => ({ ...c, i, img: c.icon.img ? media(c.icon.img) : undefined, art: arts[i]! }));
const hidden = (i: number) => (i === 0 ? '' : 'opacity:0;visibility:hidden');
const n = cs.length;
---

<section id="cavendish" class="bn relative isolate scroll-mt-20 overflow-hidden bg-[#1a1404]" aria-labelledby="bn-title" data-bn>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    {cs.map((c) => <div class="absolute inset-0" style={`${c.i === 0 ? 'opacity:1' : 'opacity:0'};background:radial-gradient(70% 80% at 70% 50%, ${c.tone[0]}, ${c.tone[1]} 70%, #0b0f0c 120%)`} data-bn-bg={c.i}></div>)}
    <div class="absolute inset-0 bg-[radial-gradient(40%_50%_at_70%_50%,rgb(255_255_255/0.12),transparent_70%)]"></div>
  </div>

  <div class="mx-auto max-w-[84rem] px-4 py-24 md:px-6 md:py-28">
    <span class="text-xs font-semibold uppercase tracking-[0.22em] text-white/75">Variety, harvest and brand</span>
    <h2 id="bn-title" class="cond mt-3 max-w-3xl text-[clamp(2.4rem,1.6rem+2.6vw,4rem)] font-medium uppercase leading-[0.95] tracking-[0.01em] text-white">Cavendish, grown the natural way</h2>

    <div class="mt-8 grid items-end gap-12 lg:mt-6 lg:grid-cols-12 lg:gap-8">
      <!-- Left: the fruit, name, harvest split and growing note. -->
      <div class="lg:col-span-5">
        <div class="min-w-0 text-center lg:text-left">
          <div class="relative mx-auto mb-4 aspect-square w-[min(72vw,24rem)] lg:-ml-6" style="perspective:1000px" data-bn-stage-art aria-hidden="true">
            <div class="absolute inset-[8%] rounded-full border border-white/25 bg-white/[0.06] shadow-[inset_0_1px_0_rgb(255_255_255/0.3)] [backdrop-filter:blur(6px)]"></div>
            <div class="absolute inset-0 rounded-full border border-dashed border-white/15" data-bn-orbit></div>
            {cs.map((c) => (
              <div class="absolute inset-0 flex items-center justify-center" style={hidden(c.i)} data-bn-art={c.i}>
                <Image src={c.art} alt="" widths={[480, 720].filter((w) => w <= c.art.width)} sizes="24rem" class="h-auto w-[84%] drop-shadow-[0_30px_36px_rgba(0,0,0,0.45)]" />
              </div>
            ))}
          </div>
          <p class="cond text-[clamp(2.4rem,1.8rem+2vw,3.6rem)] font-medium uppercase leading-[0.92] text-white">Cavendish</p>
          <p class="mt-2 flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-white/80 lg:justify-start">
            <span class="inline-block size-3 rounded-full bg-[#f2cf3c] ring-1 ring-white/50"></span>Sold as Mala-Mala bananas
          </p>

          <div class="bn-glass mx-auto mt-7 max-w-[30rem] rounded-[24px] px-5 pb-4 pt-4 text-left lg:mx-0">
            <!-- Harvest split: two-thirds in summer, the rest in winter. -->
            <p class="mb-3 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-white">Harvest: two-thirds in summer, the rest in winter</p>
            <div class="flex h-3 gap-1" aria-hidden="true">
              <span class="bn-sbar h-3 rounded-full" style="flex:2" data-bn-bar></span>
              <span class="bn-wbar h-3 rounded-full" style="flex:1" data-bn-bar></span>
            </div>
            <div class="mt-2 flex text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-white/75" aria-hidden="true">
              <span class="flex items-center gap-1.5" style="flex:2"><Icon name="sun" class="size-3.5" />Summer · ⅔</span>
              <span class="flex items-center gap-1.5" style="flex:1"><span class="bn-flake">❄</span>Winter · ⅓</span>
            </div>
            <p class="mt-4 flex items-center gap-2 border-t border-white/15 pt-4 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-white">
              <Icon name="leaf" class="size-4 shrink-0" />No chemicals · bio-fertiliser
            </p>
          </div>
        </div>
      </div>

      <!-- Right: one square card in view at a time, icons below. -->
      <div class="lg:col-span-7">
        <div class="bn-stage relative mx-auto w-full touch-pan-y select-none" data-bn-stage>
          <ul>
            {cs.map((c) => (
              <li class="bn-slot absolute left-1/2 top-0 w-[min(84vw,26rem)] [margin-left:calc(min(84vw,26rem)/-2)]" data-bn-card={c.i} aria-label={`${c.title}, ${c.i + 1} of ${n}`}>
                <article class="bn-glass relative flex aspect-square w-full flex-col rounded-[30px] p-6 text-white md:p-7" style={`--accent:${c.tone[0]}`} data-bn-article>
                  <div class="flex items-center justify-between gap-3">
                    <span class="rounded-lg px-3 py-1 text-[0.66rem] font-bold uppercase tracking-[0.14em] text-white" style={`background: color-mix(in srgb, ${c.tone[0]} 75%, #3a2804)`}>Bananas</span>
                    <span class="cond text-sm font-semibold tracking-[0.12em] text-white/75">{String(c.i + 1).padStart(2, '0')} / {String(n).padStart(2, '0')}</span>
                  </div>
                  <h3 class="cond mt-4 text-[clamp(1.9rem,1.5rem+1.2vw,2.5rem)] font-medium uppercase leading-[0.95] text-white">{c.title}</h3>
                  <p class="mt-3 border-t border-white/20 pt-3 text-[0.92rem] leading-relaxed text-white/90">{c.text}</p>
                  <p class="mt-auto flex items-end gap-3 pt-4">
                    <span class="cond text-[clamp(3rem,2.4rem+2vw,4.4rem)] font-medium leading-[0.8] text-white">{c.stat}</span>
                    <span class="pb-1 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-white/75">{c.statLabel}</span>
                  </p>
                </article>
              </li>
            ))}
          </ul>
        </div>
        <div class="mt-4 flex items-center justify-center gap-4">
          <button type="button" class="bn-arrow flex size-11 items-center justify-center rounded-full" aria-label="Previous" data-bn-prev><Icon name="arrow" class="size-5 rotate-180" /></button>
          <ol class="flex items-center gap-2" aria-hidden="true">
            {cs.map((c) => <li class:list={['bn-dot h-1.5 rounded-full', c.i === 0 && 'is-on']} data-bn-dot={c.i}></li>)}
          </ol>
          <button type="button" class="bn-arrow flex size-11 items-center justify-center rounded-full" aria-label="Next" data-bn-next><Icon name="arrow" class="size-5" /></button>
        </div>
        <div class="bn-rail mx-auto mt-8 flex w-full max-w-[22rem] justify-between gap-1 rounded-full p-1.5 sm:p-2" role="tablist" aria-label="Choose a topic">
          {cs.map((c) => (
            <button type="button" role="tab" aria-selected={c.i === 0 ? 'true' : 'false'} tabindex={c.i === 0 ? 0 : -1} class="bn-pick group flex flex-1 flex-col items-center gap-1 rounded-[20px] px-1 py-1.5 sm:px-2" style={`--accent:${c.tone[0]}`} data-bn-pick={c.i}>
              <span class="bn-pick-dot flex size-12 items-center justify-center rounded-full text-white sm:size-14">
                {c.img ? <Image src={c.img} alt="" widths={[160]} sizes="56px" class="h-[74%] w-auto object-contain transition-transform duration-500 group-hover:-translate-y-0.5 group-hover:scale-110" /> : <Icon name={c.icon.line!} class="size-6 transition-transform duration-500 group-hover:scale-110" />}
              </span>
              <span class="text-[0.56rem] font-semibold uppercase tracking-[0.1em] text-white/80 sm:text-[0.6rem]">{c.short}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bn-rail,
  .bn-arrow {
    background: linear-gradient(160deg, rgb(214 230 250 / 0.2), rgb(150 182 222 / 0.08));
    border: 1px solid rgb(225 238 255 / 0.32);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.3), 0 30px 60px -30px rgb(0 0 0 / 0.5);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    backdrop-filter: blur(18px) saturate(150%);
  }
  .bn-arrow {
    color: #fff;
    transition: background-color 0.3s, opacity 0.3s;
  }
  .bn-arrow:hover {
    background: rgb(255 255 255 / 0.22);
  }
  .bn-arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  /* Same cue as the citrus and avocado pages: the next arrow breathes twice in warm green (outline and arrow only). */
  .bn-arrow.is-breathe {
    animation: bn-breathe 1.3s ease-in-out 2;
  }
  @keyframes bn-breathe {
    0%,
    100% {
      transform: scale(1);
      color: #fff;
      border-color: rgb(225 238 255 / 0.32);
    }
    50% {
      transform: scale(1.12);
      color: #74c365;
      border-color: #74c365;
      box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.3), 0 0 0 1px #74c365, 0 0 16px rgb(116 195 101 / 0.45);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bn-arrow.is-breathe {
      animation: none;
    }
  }
  .bn-dot {
    width: 0.75rem;
    background: rgb(255 255 255 / 0.3);
    transition: width 0.4s, background-color 0.4s;
  }
  .bn-dot.is-on {
    width: 1.75rem;
    background: #fff;
  }
  .bn-pick-dot {
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.18);
    transition: background-color 0.4s, border-color 0.4s, box-shadow 0.4s;
  }
  .bn-pick[aria-selected='true'] .bn-pick-dot {
    background: color-mix(in srgb, var(--accent) 55%, transparent);
    border-color: rgb(255 255 255 / 0.7);
    box-shadow: 0 0 0 4px rgb(255 255 255 / 0.12), 0 12px 30px -10px var(--accent);
  }
  .bn-pick[aria-selected='true'] span:last-child {
    color: #fff;
  }
  .bn-pick:focus-visible,
  .bn-arrow:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .bn-glass {
    background:
      radial-gradient(90% 60% at 85% 0%, color-mix(in srgb, var(--accent, transparent) 20%, transparent), transparent 70%),
      linear-gradient(160deg, rgb(214 230 250 / 0.22), rgb(150 182 222 / 0.1));
    border: 1px solid rgb(225 238 255 / 0.36);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 40px 80px -30px rgb(0 0 0 / 0.5);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    backdrop-filter: blur(22px) saturate(150%);
  }
  .bn-slot {
    will-change: transform;
  }
  .bn-sbar {
    background: #fff;
    box-shadow: 0 0 14px rgb(255 255 255 / 0.45);
  }
  .bn-wbar {
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.6) 0 6px, transparent 6px 10px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
  }
  .bn-flake {
    font-size: 0.8rem;
    line-height: 1;
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.querySelectorAll<HTMLElement>('[data-bn]').forEach((root) => {
    const q = (s: string) => [...root.querySelectorAll<HTMLElement>(s)];
    const cards = q('[data-bn-card]');
    const dots = q('[data-bn-dot]');
    const picks = q('[data-bn-pick]') as HTMLButtonElement[];
    const bgs = q('[data-bn-bg]');
    const arts = q('[data-bn-art]');
    const bars = q('[data-bn-bar]');
    const prev = root.querySelector<HTMLButtonElement>('[data-bn-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-bn-next]')!;
    const artStage = root.querySelector<HTMLElement>('[data-bn-stage-art]')!;
    const stage = root.querySelector<HTMLElement>('[data-bn-stage]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const d = reduce ? 0 : 1;
    const state = { pos: 0 };
    let at = 0;

    // Active card centred, neighbours smaller and tucked behind (phones: a stacked deck).
    const place = (pos: number) => {
      const w = cards[0]!.offsetWidth || 340;
      const deck = window.innerWidth < 768;
      const stageW = stage.offsetWidth || w * 2.4;
      const side = Math.min(w * 0.7, Math.max(0, (stageW - w * 0.78) / 2));
      cards.forEach((card, i) => {
        const dd = i - pos;
        const t = Math.abs(dd);
        const s = Math.sign(dd);
        gsap.set(card, {
          x: deck ? s * Math.min(t, 1.5) * w * 0.07 : s * Math.min(t, 1.6) * side,
          y: deck ? Math.min(t, 1.5) * -14 : 0,
          rotation: deck ? s * Math.min(t, 1.5) * 4 : 0,
          scale: 1 - Math.min(t, 1.5) * (deck ? 0.07 : 0.22),
          rotationY: deck ? 0 : -s * Math.min(t, 1) * 18,
          transformPerspective: 1100,
          zIndex: 50 - Math.round(t * 10),
          opacity: t > 1.4 ? Math.max(0, 1 - (t - 1.4) * 3) : 1,
          filter: `brightness(${1 - Math.min(t, 1) * 0.3})`,
          pointerEvents: t < 1.5 ? 'auto' : 'none',
        });
        card.setAttribute('aria-hidden', t < 0.5 ? 'false' : 'true');
        gsap.set(card.querySelectorAll('h3, p, span'), { opacity: Math.max(0, 1 - t * 1.6) });
      });
    };

    const breathe = () => {
      if (next.disabled) return;
      next.classList.remove('is-breathe');
      void next.offsetWidth;
      next.classList.add('is-breathe');
      next.addEventListener('animationend', () => next.classList.remove('is-breathe'), { once: true });
    };

    function go(i: number, first = false) {
      const to = Math.max(0, Math.min(cards.length - 1, i));
      const from = at;
      at = to;
      gsap.to(state, { pos: to, duration: 0.7 * d, ease: 'power3.out', overwrite: true, onUpdate: () => place(state.pos) });
      if (!d) place(to);
      dots.forEach((dot, di) => dot.classList.toggle('is-on', di === to));
      prev.disabled = to === 0;
      next.disabled = to === cards.length - 1;
      picks.forEach((p, pi) => {
        p.setAttribute('aria-selected', pi === to ? 'true' : 'false');
        p.tabIndex = pi === to ? 0 : -1;
      });
      if (first || from === to) return;

      // The fruit turns away and the next one swings in; the section takes the new card's colour.
      const dir = to > from ? 1 : -1;
      gsap.killTweensOf([...bgs, ...arts]);
      arts.forEach((el, ai) => ai !== from && ai !== to && gsap.set(el, { autoAlpha: 0 }));
      gsap.to(arts[from]!, { autoAlpha: 0, rotationY: -70 * dir, xPercent: -30 * dir, scale: 0.6, duration: 0.45 * d, ease: 'power3.in' });
      gsap.fromTo(arts[to]!, { autoAlpha: 0, rotationY: 80 * dir, xPercent: 35 * dir, scale: 0.5 }, { autoAlpha: 1, rotationY: 0, xPercent: 0, scale: 1, duration: 1 * d, ease: 'back.out(1.4)', delay: 0.15 * d });
      bgs.forEach((el, k) => k !== from && k !== to && gsap.set(el, { opacity: 0 }));
      gsap.to(bgs[from]!, { opacity: 0, duration: 0.7 * d });
      gsap.to(bgs[to]!, { opacity: 1, duration: 0.7 * d });
      window.setTimeout(breathe, 700 * d);
    }

    prev.addEventListener('click', () => go(at - 1));
    next.addEventListener('click', () => go(at + 1));
    cards.forEach((c, i) => c.addEventListener('click', () => i !== at && go(i)));
    picks.forEach((p, i) => {
      p.addEventListener('click', () => go(i));
      p.addEventListener('keydown', (e) => {
        if (!['ArrowRight', 'ArrowLeft'].includes(e.key)) return;
        e.preventDefault();
        const k = (i + (e.key === 'ArrowRight' ? 1 : picks.length - 1)) % picks.length;
        picks[k]!.focus();
        go(k);
      });
    });
    let x0: number | null = null;
    stage.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    stage.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 40) go(at + (dx < 0 ? 1 : -1));
      x0 = null;
    });

    // Every card is square, or taller only if the longest text needs it; all share that size.
    const articles = q('[data-bn-article]');
    const size = () => {
      articles.forEach((a) => (a.style.height = ''));
      const h = Math.max(...articles.map((a) => a.offsetHeight));
      articles.forEach((a) => (a.style.height = `${h}px`));
      stage.style.height = `${h + 24}px`;
      place(state.pos);
    };
    go(0, true);
    size();
    window.addEventListener('resize', size);
    document.fonts?.ready.then(size);

    if (!reduce) {
      gsap.to(root.querySelector('[data-bn-orbit]'), { rotate: 360, duration: 60, ease: 'none', repeat: -1 });
      // A gentle sway, like a bunch hanging from the plant.
      arts.forEach((a) => gsap.to(a.firstElementChild, { y: -10, rotate: 4, duration: 3.4, ease: 'sine.inOut', yoyo: true, repeat: -1, transformOrigin: '60% 0%' }));
      if (window.matchMedia('(hover: hover)').matches) {
        const rx = gsap.quickTo(artStage, 'rotationX', { duration: 0.8, ease: 'power3' });
        const ry = gsap.quickTo(artStage, 'rotationY', { duration: 0.8, ease: 'power3' });
        root.addEventListener('pointermove', (e) => {
          const r = artStage.getBoundingClientRect();
          ry(((e.clientX - (r.left + r.width / 2)) / window.innerWidth) * 30);
          rx((-(e.clientY - (r.top + r.height / 2)) / window.innerHeight) * 24);
        });
        root.addEventListener('pointerleave', () => (rx(0), ry(0)));
      }
      gsap.set(bars, { scaleX: 0, transformOrigin: 'left center' });
      new IntersectionObserver(([e], o) => {
        if (!e!.isIntersecting) return;
        gsap.to(bars, { scaleX: 1, duration: 1.1, stagger: 0.25, ease: 'power3.out' });
        window.setTimeout(breathe, 600);
        o.disconnect();
      }, { threshold: 0.5 }).observe(bars[0]!);
    }
  });
</script>
