---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { media } from '../../lib/media';
import { site } from '../../data/site';

const cols = [
  {
    title: 'Group',
    links: [
      { label: 'About us', href: '/about-us' },
      { label: 'Board of directors', href: '/about-us/leadership' },
      { label: 'Mahela Cares', href: '/mahela-cares' },
      { label: 'Mahela Game', href: '/mahela-game' },
      { label: 'News', href: '/news' },
    ],
  },
  {
    title: 'Produce',
    links: [
      { label: 'Citrus', href: '/produce/citrus' },
      { label: 'Avocados', href: '/produce/avocados' },
      { label: 'Bananas', href: '/produce/bananas' },
      { label: 'Macadamias', href: '/produce/macadamias' },
      { label: 'Litchis', href: '/produce/litchis' },
      { label: 'Golden kiwis', href: '/produce/kiwis' },
    ],
  },
  {
    title: 'Export',
    links: [
      { label: 'Export and markets', href: '/export' },
      { label: 'Packhouses', href: '/packhouses' },
      { label: 'Contact the export team', href: '/contact-us' },
    ],
  },
];
const certs = [
  { src: 'certifications/globalgap.png', alt: 'GlobalGAP' },
  { src: 'certifications/siza.png', alt: 'SIZA' },
  { src: 'certifications/nsf-registered.png', alt: 'NSF Registered' },
];
const year = new Date().getFullYear();
---

<footer class="relative z-10 px-3 pb-4 pt-16 md:px-6">
  <div class="glass-dark mx-auto max-w-[84rem] rounded-[28px] px-6 py-10 md:px-10 md:py-12">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href="/" class="flex items-center gap-3" aria-label="Mahela Group home">
          <Image src={media('brand/mahela-emblem-hires.png')} alt="" width={88} height={82} class="h-11 w-auto" />
          <span class="leading-none">
            <span class="cond block text-xl font-semibold tracking-[0.14em]">MAHELA</span>
            <span class="block pt-0.5 text-[0.6rem] font-medium uppercase tracking-[0.42em] text-ivory/70">Group</span>
          </span>
        </a>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-ivory/70">
          A 4th generation agricultural company in the Lowveld of Limpopo, South Africa, and one of the country’s biggest privately-owned citrus producers and exporters.
        </p>
        <ul class="mt-6 flex items-center gap-4" aria-label="Certifications">
          {certs.map((c) => <li><Image src={media(c.src)} alt={c.alt} height={40} class="h-9 w-auto opacity-80 brightness-0 invert" /></li>)}
        </ul>
      </div>
      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-5" aria-label="Footer">
        {
          cols.map((c) => (
            <div>
              <h2 class="cond text-sm font-semibold uppercase tracking-[0.16em] text-sage">{c.title}</h2>
              <ul class="mt-4 space-y-2.5 text-sm text-ivory/75">
                {c.links.map((l) => <li><a href={l.href} class="transition-colors hover:text-white">{l.label}</a></li>)}
              </ul>
            </div>
          ))
        }
      </nav>
      <address class="space-y-3 text-sm not-italic text-ivory/75 lg:col-span-3">
        <h2 class="cond text-sm font-semibold uppercase tracking-[0.16em] text-sage">Head office</h2>
        <p class="flex gap-2"><Icon name="pin" class="mt-0.5 size-4 shrink-0" />{site.address.street}, {site.address.locality}, {site.address.region}, South Africa</p>
        <p class="flex gap-2"><Icon name="phone" class="mt-0.5 size-4 shrink-0" /><a href={site.phoneHref} class="hover:text-white">{site.phone}</a></p>
        <p class="flex gap-2"><Icon name="mail" class="mt-0.5 size-4 shrink-0" /><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></p>
        <p class="flex gap-2"><Icon name="clock" class="mt-0.5 size-4 shrink-0" />Mon to Fri, 08:00 to 17:00</p>
        <p class="flex gap-4 pt-2">
          <a href={site.social.facebook} class="glass-soft rounded-full px-4 py-1.5 text-xs uppercase tracking-[0.14em]" rel="noopener" target="_blank">Facebook</a>
          <a href={site.social.x} class="glass-soft rounded-full px-4 py-1.5 text-xs uppercase tracking-[0.14em]" rel="noopener" target="_blank">X</a>
        </p>
      </address>
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-ivory/15 pt-6 text-xs text-ivory/55">
      <span>© {year} Mahela Group. Makulu Citrus, Mahela Boerdery and Mala-Mala Citrus are Mahela Group brands.</span>
      <span class="flex gap-5"><a href="/legal" class="hover:text-white">POPIA and privacy</a><a href="/sitemap-index.xml" class="hover:text-white">Sitemap</a></span>
    </div>
  </div>
</footer>
