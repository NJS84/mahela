---
/**
 * Free-floating 3D ridgeline relief of the Letsitele valley with the Mahela packhouse at
 * The Junction pinned. Same look as LimpopoMap3D on the Packhouses page. Drag to turn.
 * Elevation: AWS Terrain Tiles (SRTM and others).
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div
  class:list={['letsitele-map relative select-none', className]}
  data-letsitele-map
  role="img"
  aria-label="3D relief map of the Letsitele valley in Limpopo, from Tzaneen and the escarpment east across the Lowveld, with the Mahela packhouse at The Junction pinned"
>
  <div class="ls-fallback absolute inset-[12%] rounded-[40%] bg-[radial-gradient(circle,rgb(111_155_224/0.18),transparent_65%)]"></div>

  <div data-lm-site="0" class="ls-tag pointer-events-none absolute left-0 top-0 z-10">
    <span class="absolute bottom-3 left-0 -translate-x-1/2 whitespace-nowrap rounded-2xl border border-white/25 bg-[#0b2347]/60 px-3.5 py-2 text-center shadow-[0_10px_40px_rgb(0_0_0/0.35)] backdrop-blur-md">
      <span class="block text-[0.55rem] font-semibold uppercase tracking-[0.22em] text-[#ffd29a] md:text-[0.6rem]">The Junction · Letsitele</span>
      <span class="cond block text-sm font-medium uppercase tracking-[0.05em] text-white md:text-lg">Mahela packhouse</span>
      <span class="hidden text-[0.62rem] text-white/75 sm:block">Farmed since 1942</span>
    </span>
  </div>

  {['Tzaneen', 'Nkowankowa'].map((t) => (
    <div data-lm-town={t} class="ls-tag pointer-events-none absolute left-0 top-0 z-[5]">
      <span class="absolute left-0 top-0 -translate-x-[3px] -translate-y-1/2 whitespace-nowrap text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-white/70">
        <span class="mr-1 inline-block size-1.5 rounded-full bg-white/80 align-middle"></span>{t}
      </span>
    </div>
  ))}

  <p class="ls-hint pointer-events-none absolute bottom-[1%] left-1/2 -translate-x-1/2 whitespace-nowrap text-center text-[0.62rem] uppercase tracking-[0.2em] text-white/45">
    Drag to turn · Elevation data: AWS Terrain Tiles
  </p>
</div>

<style>
  .letsitele-map .ls-tag { opacity: 0; transition: opacity 0.8s ease 1.6s; }
  .letsitele-map:global(.is-live) .ls-tag { opacity: 1; }
  .letsitele-map:global([data-mounted]) .ls-fallback { display: none; }
  .letsitele-map:not([data-mounted]) .ls-tag { display: none; }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>('[data-letsitele-map]');
  if (els.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          import('../../scripts/letsitele3d').then(({ mountLetsiteleMap }) => mountLetsiteleMap(e.target as HTMLElement));
        });
      },
      { rootMargin: '400px 0px' },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
