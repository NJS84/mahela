---
import { heritage } from '../../data/site';
import SectionTitle from './SectionTitle.astro';
---

<section class="relative overflow-hidden py-24 md:py-0" aria-labelledby="heritage-title" data-heritage>
  <div class="flex min-h-[100svh] flex-col justify-center">
    <div class="mx-auto w-full max-w-[84rem] px-4 md:px-6">
      <SectionTitle eyebrow={heritage.eyebrow} title={heritage.title} id="heritage-title" />
    </div>
    <div class="heritage-scroll mt-12 overflow-x-auto pb-4 md:overflow-visible" data-heritage-scroll>
      <ol class="flex w-max gap-5 px-4 md:px-[max(1.5rem,calc((100vw-84rem)/2+1.5rem))]" data-heritage-track>
        {
          heritage.milestones.map((m, i) => {
            const now = i === heritage.milestones.length - 1;
            return (
            <li class:list={['glass relative w-[78vw] max-w-[24rem] shrink-0 rounded-[28px] p-7 md:w-[24rem]', now && 'heritage-now']} data-glare>
              <span class:list={['cond block text-[4.5rem] font-semibold uppercase leading-none tabular', now ? 'text-white' : 'text-sage/80']}>{m.year}</span>
              <span class:list={['my-5 block h-px w-full', now ? 'bg-white/40' : 'bg-ivory/20']} />
              <p class:list={['leading-relaxed', now ? 'text-white' : 'text-ivory/85']}>{m.text}</p>
              <span class:list={['absolute right-6 top-6 text-xs tabular', now ? 'text-white/70' : 'text-ivory/40']}>{String(i + 1).padStart(2, '0')} / {String(heritage.milestones.length).padStart(2, '0')}</span>
            </li>
            );
          })
        }
        <li class="flex w-[60vw] max-w-[20rem] shrink-0 items-center md:w-[20rem]">
          <a href="/about-us" class="btn-forest rounded-full px-6 py-3.5 text-xs font-semibold uppercase tracking-[0.16em]">The full story</a>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  /* The present day, in Mahela orange. */
  .heritage-now {
    background: linear-gradient(140deg, rgb(255 150 40 / 0.88), rgb(232 98 10 / 0.82));
    border-color: rgb(255 200 140 / 0.55);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      0 30px 70px -25px rgb(232 98 10 / 0.65);
  }
  /* Cards fade in and out at the screen edges instead of being cut by a hard line. */
  @media (min-width: 768px) {
    .heritage-scroll {
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
    }
  }
</style>
