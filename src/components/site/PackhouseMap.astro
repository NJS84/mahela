---
/**
 * Line map of the Mahela packhouse at The Junction, Letsitele.
 * Roads, orchards and dams come from OpenStreetMap (ODbL); building
 * footprints were traced from aerial imagery. Lines draw in when the map
 * scrolls into view.
 */
import map from '../../data/packhouse-map.json';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const { W, H, orch, water, roads, blds, main, pin, scale100 } = map as {
  W: number; H: number; orch: string[]; water: string[];
  roads: Record<'primary' | 'secondary' | 'minor' | 'track', string[]>;
  blds: string[]; main: string; pin: [number, number]; scale100: number;
};
const [px, py] = pin;
const scale50 = scale100 / 2;
---

<figure class:list={['packhouse-map glass-soft relative overflow-hidden rounded-[28px] p-1.5', className]} data-reveal>
  <div class="relative overflow-hidden rounded-[22px] bg-[radial-gradient(120%_90%_at_60%_55%,#16386f_0%,#0b2347_55%,#061833_100%)]">
    <svg viewBox={`0 0 ${W} ${H}`} class="block h-auto w-full" role="img" aria-labelledby="pmap-title pmap-desc">
      <title id="pmap-title">Map of the Mahela packhouse at The Junction, Letsitele</title>
      <desc id="pmap-desc">Line map showing the Mahela packhouse buildings, the surrounding citrus orchards, farm dams and the R71/R529 road outside Letsitele, Limpopo.</desc>
      <defs>
        <pattern id="pmap-rows" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(-39)">
          <line x1="0" y1="0" x2="0" y2="7" stroke="#8fb4f0" stroke-width="1" stroke-opacity="0.22" />
        </pattern>
        <pattern id="pmap-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M40 0H0V40" fill="none" stroke="#9cc0ff" stroke-opacity="0.06" stroke-width="1" />
        </pattern>
        <radialGradient id="pmap-glow">
          <stop offset="0" stop-color="#9cc0ff" stop-opacity="0.45" />
          <stop offset="1" stop-color="#9cc0ff" stop-opacity="0" />
        </radialGradient>
      </defs>

      <rect width={W} height={H} fill="url(#pmap-grid)" />

      <g class="pm-orch">
        {orch.map((d) => <path d={d} fill="url(#pmap-rows)" stroke="#7ea6ea" stroke-opacity="0.75" stroke-width="1.1" stroke-linejoin="round" pathLength="1" />)}
      </g>
      <g class="pm-water">
        {water.map((d) => <path d={d} fill="#3a7be0" fill-opacity="0.22" stroke="#9cc0ff" stroke-width="1.4" pathLength="1" />)}
      </g>
      <g class="pm-roads" fill="none" stroke-linecap="round" stroke-linejoin="round">
        {roads.track.map((d) => <path d={d} stroke="#f5f2ea" stroke-opacity="0.45" stroke-width="1" stroke-dasharray="3 4" />)}
        {roads.minor.map((d) => <path d={d} stroke="#f5f2ea" stroke-opacity="0.8" stroke-width="1.8" pathLength="1" class="pm-line" />)}
        {roads.primary.map((d) => <path d={d} stroke="#f5f2ea" stroke-width="5" pathLength="1" class="pm-line" />)}
        {roads.primary.map((d) => <path d={d} stroke="#0b2347" stroke-width="1.6" pathLength="1" class="pm-line" />)}
      </g>
      <g class="pm-blds" stroke-linejoin="round">
        {blds.map((d) => <path d={d} fill="#f5f2ea" fill-opacity="0.08" stroke="#f5f2ea" stroke-width="1.3" pathLength="1" />)}
      </g>

      <circle cx={px} cy={py} r="120" fill="url(#pmap-glow)" class="pm-glow" />
      <path d={main} class="pm-main" fill="#9cc0ff" fill-opacity="0.28" stroke="#ffffff" stroke-width="2.4" stroke-linejoin="round" pathLength="1" />

      <g class="pm-pin" transform={`translate(${px} ${py - 6})`}>
        <circle cy="-23" r="16" fill="none" stroke="#ffffff" stroke-width="1.5" class="pm-pulse" />
        <path d="M0 0c-8-10-13-16-13-23a13 13 0 1 1 26 0c0 7-5 13-13 23z" fill="#274486" stroke="#ffffff" stroke-width="2" />
        <circle cy="-23" r="4.5" fill="#ffffff" />
      </g>

      <g class="pm-labels" font-family="Inter, system-ui, sans-serif" fill="#f5f2ea">
        <g transform="translate(590 47) rotate(4.5)">
          <rect x="-34" y="-11" width="68" height="22" rx="11" fill="#f5f2ea" />
          <text text-anchor="middle" y="4.5" font-size="12" font-weight="700" fill="#0b2347" letter-spacing="0.06em">R71 · R529</text>
        </g>
        <text x="20" y={H - 22} font-size="11" font-weight="600" letter-spacing="0.2em" fill-opacity="0.7">CITRUS ORCHARDS</text>
      </g>

      <g transform={`translate(${W - 44} ${H - 92})`} class="pm-compass" fill="none" stroke="#f5f2ea">
        <circle r="18" stroke-opacity="0.5" />
        <path d="M0 -13 L5 4 L0 0 L-5 4 Z" fill="#f5f2ea" stroke="none" />
        <text y="-23" text-anchor="middle" font-size="10" font-weight="700" fill="#f5f2ea" stroke="none" font-family="Inter, system-ui, sans-serif">N</text>
      </g>

      <g transform={`translate(${W - 24 - scale50} ${H - 26})`} stroke="#f5f2ea" font-family="Inter, system-ui, sans-serif">
        <path d={`M0 -4V0H${scale50}V-4`} fill="none" stroke-width="1.5" />
        <text x={scale50 / 2} y="-9" text-anchor="middle" font-size="10" fill="#f5f2ea" stroke="none" letter-spacing="0.08em">50 m</text>
      </g>
    </svg>

    <figcaption class="pointer-events-none absolute left-3 top-3 rounded-2xl border border-ivory/20 bg-[#061833]/60 px-3 py-2 backdrop-blur-md md:left-5 md:top-5 md:px-4 md:py-3">
      <span class="block whitespace-nowrap text-[0.55rem] font-semibold uppercase tracking-[0.2em] text-[#9cc0ff] md:text-[0.65rem] md:tracking-[0.22em]">The Junction · Letsitele</span>
      <span class="cond mt-0.5 block whitespace-nowrap text-base font-medium uppercase leading-tight tracking-[0.04em] text-ivory md:mt-1 md:text-xl">Mahela packhouse</span>
    </figcaption>
    <p class="border-t border-ivory/10 py-2 text-center text-[0.6rem] text-ivory/45">Map data © <a class="underline-offset-2 hover:underline" href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">OpenStreetMap</a> contributors</p>
  </div>
</figure>

<style>
  .packhouse-map :global(.pm-orch path),
  .packhouse-map :global(.pm-water path),
  .packhouse-map :global(.pm-line),
  .packhouse-map :global(.pm-blds path),
  .packhouse-map :global(.pm-main) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .packhouse-map :global(.pm-orch path) { transition-duration: 2.2s; }
  .packhouse-map :global(.pm-blds path) { transition-delay: 0.6s; }
  .packhouse-map :global(.pm-main) { transition-delay: 0.9s; transition-duration: 1.4s; }
  .packhouse-map :global(.pm-pin),
  .packhouse-map :global(.pm-glow),
  .packhouse-map :global(.pm-labels) { opacity: 0; transition: opacity 0.8s ease 1.6s; }
  .packhouse-map.is-drawn :global(path) { stroke-dashoffset: 0 !important; }
  .packhouse-map.is-drawn :global(.pm-pin),
  .packhouse-map.is-drawn :global(.pm-glow),
  .packhouse-map.is-drawn :global(.pm-labels) { opacity: 1; }
  .packhouse-map :global(.pm-pulse) { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .packhouse-map.is-drawn :global(.pm-pulse) { animation: pm-pulse 2.4s ease-out 2.2s infinite; }
  @keyframes pm-pulse {
    0% { transform: scale(0.6); opacity: 0.9; }
    100% { transform: scale(2.4); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .packhouse-map :global(path) { transition: none !important; stroke-dashoffset: 0 !important; }
    .packhouse-map :global(.pm-pin), .packhouse-map :global(.pm-glow), .packhouse-map :global(.pm-labels) { opacity: 1; transition: none; }
    .packhouse-map :global(.pm-pulse) { animation: none !important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.packhouse-map').forEach((el) => {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            el.classList.add('is-drawn');
            io.disconnect();
          }
        });
      },
      { threshold: 0.3 },
    );
    io.observe(el);
  });
</script>
