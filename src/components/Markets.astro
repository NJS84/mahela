---
import { markets } from '../data/site';

// Simple equirectangular projection into a 1000 × 500 box.
const proj = (lon: number, lat: number) => ({ x: ((lon + 180) / 360) * 1000, y: ((90 - lat) / 180) * 500 });
const origin = proj(30.5, -23.8); // Letsitele, Limpopo
const points: { name: string; x: number; y: number; left?: boolean }[] = [
  { name: 'Europe', ...proj(8, 50), left: true },
  { name: 'Russia', ...proj(37.6, 55.8) },
  { name: 'Middle East', ...proj(50, 25), left: true },
  { name: 'Asia', ...proj(104, 30) },
  { name: 'Japan', ...proj(139.7, 35.7) },
];
const arc = (p: { x: number; y: number }) => {
  const mx = (origin.x + p.x) / 2;
  const my = Math.min(origin.y, p.y) - Math.abs(p.x - origin.x) * 0.35 - 30;
  return `M${origin.x} ${origin.y} Q${mx} ${my} ${p.x} ${p.y}`;
};
---

<section class="bg-bone-deep py-24 md:py-36" aria-labelledby="markets-title">
  <div class="container-x">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-6">
        <p class="eyebrow text-green-700" data-reveal>{markets.eyebrow}</p>
        <h2 id="markets-title" class="font-display mt-5 text-h2 font-light text-green-950" data-split>{markets.title}</h2>
      </div>
      <p class="text-lg leading-relaxed text-ink-soft md:col-span-5 md:col-start-8 md:pt-12" data-reveal>{markets.lead}</p>
    </div>

    <figure class="mt-16 overflow-hidden rounded-3xl bg-green-950 p-4 md:p-8" data-reveal>
      <svg viewBox="430 50 540 300" class="h-auto w-full" role="img" aria-labelledby="map-desc" data-routes>
        <desc id="map-desc">Export routes from Letsitele, Limpopo, to Europe, Russia, the Middle East, Asia and Japan.</desc>
        <defs>
          <pattern id="dots" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="11" cy="11" r="1.6" fill="#ffffff" fill-opacity="0.07"></circle></pattern>
        </defs>
        <rect x="0" y="0" width="1000" height="500" fill="url(#dots)"></rect>
        {points.map((p) => <path d={arc(p)} fill="none" stroke="#d4e157" stroke-width="1.6" stroke-linecap="round" class="route" />)}
        {
          points.map((p) => (
            <g>
              <circle cx={p.x} cy={p.y} r="5" fill="#d4e157" />
              <circle cx={p.x} cy={p.y} r="12" fill="none" stroke="#d4e157" stroke-opacity="0.35" />
              <text x={p.left ? p.x - 16 : p.x + 16} y={p.y + 4} text-anchor={p.left ? 'end' : 'start'} fill="#ffffff" fill-opacity="0.8" font-size="13" font-family="Inter Variable, sans-serif">
                {p.name}
              </text>
            </g>
          ))
        }
        <circle cx={origin.x} cy={origin.y} r="7" fill="#ffffff"></circle>
        <circle cx={origin.x} cy={origin.y} r="16" fill="none" stroke="#ffffff" stroke-opacity="0.4"></circle>
        <text x={origin.x + 20} y={origin.y + 5} fill="#ffffff" font-size="14" font-weight="600" font-family="Inter Variable, sans-serif">Letsitele, Limpopo</text>
      </svg>
      <figcaption class="sr-only">Export destinations map</figcaption>
    </figure>

    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        markets.regions.map((r) => (
          <li class:list={['rounded-3xl p-6', r.primary ? 'bg-green-700 text-white' : 'bg-bone']} data-reveal>
            <h3 class="eyebrow">{r.name}</h3>
            {r.primary && <p class="eyebrow mt-2 text-lime">Primary focus</p>}
            <p class:list={['mt-6 text-[0.95rem] leading-relaxed', r.primary ? 'text-white/80' : 'text-ink-soft']}>{r.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
