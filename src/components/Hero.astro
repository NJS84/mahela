---
import { hero } from '../data/site';
---

<section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-green-950 text-white" aria-labelledby="hero-title">
  <!-- Layer 1: landscape (placeholder until orchard photography is supplied) -->
  <div class="absolute inset-0 -z-30" data-parallax="0.15">
    <div class="ph absolute inset-[-10%]" style="--ph-a:#1f5a3a;--ph-b:#07170f" data-label="Hero photo: orchard / Lowveld landscape"></div>
  </div>

  <!-- Layer 2: orchard rows, drawn -->
  <svg class="absolute inset-x-0 bottom-0 -z-20 h-[58%] w-full opacity-40" viewBox="0 0 1440 520" preserveAspectRatio="xMidYMax slice" aria-hidden="true" data-parallax="0.3">
    <defs>
      <linearGradient id="row" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#3e7c4f" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#3e7c4f"></stop>
      </linearGradient>
    </defs>
    {
      Array.from({ length: 9 }).map((_, i) => (
        <path d={`M720 40 L${-260 + i * 245} 520`} stroke="url(#row)" stroke-width={1 + i * 0.25} fill="none" />
      ))
    }
    <path d="M0 400 Q360 360 720 380 T1440 370 V520 H0Z" fill="#0c2418" opacity="0.85"></path>
  </svg>

  <!-- Layer 3: citrus slice, foreground depth -->
  <div class="pointer-events-none absolute -right-[16vw] top-[8%] -z-10 w-[40vw] md:-right-[6vw] md:top-[12%] md:w-[min(56vw,760px)]" data-parallax="-0.25" aria-hidden="true">
    <svg viewBox="0 0 400 400" class="h-auto w-full drop-shadow-[0_40px_80px_rgba(0,0,0,0.45)]" data-hero-slice>
      <circle cx="200" cy="200" r="196" fill="#e8742a"></circle>
      <circle cx="200" cy="200" r="178" fill="#fbe7c4"></circle>
      <circle cx="200" cy="200" r="168" fill="#f39a3d"></circle>
      {
        Array.from({ length: 11 }).map((_, i) => {
          const a = (i / 11) * Math.PI * 2;
          const b = ((i + 1) / 11) * Math.PI * 2;
          const r = 158;
          const x1 = 200 + Math.cos(a + 0.04) * r;
          const y1 = 200 + Math.sin(a + 0.04) * r;
          const x2 = 200 + Math.cos(b - 0.04) * r;
          const y2 = 200 + Math.sin(b - 0.04) * r;
          return (
            <path d={`M${200 + Math.cos((a + b) / 2) * 14} ${200 + Math.sin((a + b) / 2) * 14} L${x1} ${y1} A${r} ${r} 0 0 1 ${x2} ${y2} Z`} fill="#f7b04f" opacity="0.92" />
          );
        })
      }
      <circle cx="200" cy="200" r="16" fill="#fbe7c4"></circle>
    </svg>
  </div>

  <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-t from-green-950 via-green-950/40 to-transparent"></div>

  <div class="container-x relative pb-16 pt-40 md:pb-24">
    <p class="eyebrow mb-6 text-lime" data-reveal>{hero.eyebrow}</p>
    <h1 id="hero-title" class="font-display max-w-[14ch] text-display font-light" data-split>
      {hero.title}
    </h1>
    <div class="mt-10 grid gap-10 md:grid-cols-12 md:items-end">
      <p class="max-w-xl text-lg leading-relaxed text-white/80 md:col-span-6" data-reveal>{hero.lead}</p>
      <div class="flex flex-wrap gap-3 md:col-span-6 md:justify-end" data-reveal>
        <a href={hero.primary.href} class="inline-flex items-center gap-2 rounded-full bg-lime px-6 py-3.5 font-semibold text-green-950 transition-transform duration-300 hover:-translate-y-0.5">
          {hero.primary.label}
          <span aria-hidden="true">→</span>
        </a>
        <a href={hero.secondary.href} class="inline-flex items-center rounded-full border border-white/30 px-6 py-3.5 font-medium text-white transition-colors hover:bg-white/10">
          {hero.secondary.label}
        </a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 md:block" aria-hidden="true">
    <span class="block h-12 w-px origin-top animate-pulse bg-white/40"></span>
  </div>
</section>
