---
import Logo from './Logo.astro';
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-green-950 text-white/75">
  <div class="container-x py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <Logo tone="light" />
        <p class="mt-6 max-w-xs leading-relaxed">A 4th generation agricultural company in the Lowveld of Limpopo, producing and exporting premium citrus and subtropical fruit since 1942.</p>
        <form class="mt-8 max-w-sm" action="/api/subscribe" method="post">
          <label for="newsletter-email" class="eyebrow text-white/60">Seasonal crop &amp; export updates</label>
          <div class="mt-3 flex rounded-full border border-white/20 p-1 focus-within:border-lime">
            <input id="newsletter-email" type="email" name="email" required autocomplete="email" placeholder="Email address" class="min-w-0 flex-1 bg-transparent px-4 text-sm text-white placeholder:text-white/40 focus:outline-none" />
            <button type="submit" class="rounded-full bg-lime px-4 py-2 text-sm font-semibold text-green-950">Subscribe</button>
          </div>
        </form>
      </div>

      <div class="md:col-span-3 md:col-start-6">
        <h2 class="eyebrow text-white/50">Head office</h2>
        <address class="mt-5 space-y-2 not-italic leading-relaxed">
          <p>{site.address.street}<br />{site.address.locality}, South Africa</p>
          <p>{site.address.postal}</p>
          <p><a href={site.phoneHref} class="hover:text-lime">Tel {site.phone}</a></p>
          <p><a href={`mailto:${site.email}`} class="hover:text-lime">{site.email}</a></p>
          <p class="text-sm text-white/50">{site.hours}</p>
        </address>
      </div>

      <nav class="md:col-span-2" aria-label="Footer">
        <h2 class="eyebrow text-white/50">Explore</h2>
        <ul class="mt-5 space-y-2">
          {nav.map((n) => <li><a href={n.href} class="hover:text-lime">{n.label}</a></li>)}
          <li><a href="/contact-us" class="hover:text-lime">Contact</a></li>
        </ul>
      </nav>

      <div class="md:col-span-2">
        <h2 class="eyebrow text-white/50">Follow</h2>
        <ul class="mt-5 space-y-2">
          <li><a href={site.social.facebook} rel="noopener" class="hover:text-lime">Facebook</a></li>
          <li><a href={site.social.x} rel="noopener" class="hover:text-lime">X</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-8 text-sm text-white/45">
      <p>© {year} Mahela Group. All rights reserved.</p>
      <p class="flex gap-6">
        <a href="/legal" class="hover:text-lime">POPIA &amp; legal</a>
        <a href="https://www.web-guys.com" rel="noopener" class="hover:text-lime">Design &amp; development by Web Guys</a>
      </p>
    </div>
  </div>
</footer>
