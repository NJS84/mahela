---
import Logo from './Logo.astro';
import { nav } from '../data/site';
---

<header
  id="site-header"
  data-state="top"
  class="group/header fixed inset-x-0 top-0 z-50 transition-[background-color,box-shadow,padding] duration-500 ease-out-expo data-[state=scrolled]:bg-bone/90 data-[state=scrolled]:shadow-[0_1px_0_var(--color-line)] data-[state=scrolled]:backdrop-blur-md"
>
  <div class="container-x flex items-center justify-between py-5 transition-[padding] duration-500 group-data-[state=scrolled]/header:py-3">
    <a href="/" class="relative z-10 shrink-0" aria-label="Mahela Group home">
      <span class="group-data-[state=scrolled]/header:hidden"><Logo tone="light" /></span>
      <span class="hidden group-data-[state=scrolled]/header:inline"><Logo /></span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-full px-3.5 py-2 text-[0.9rem] font-medium text-white/85 transition-colors hover:text-white group-data-[state=scrolled]/header:text-ink-soft group-data-[state=scrolled]/header:hover:text-green-800"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact-us"
        class="hidden rounded-full bg-lime px-5 py-2.5 text-sm font-semibold text-green-950 transition-transform duration-300 hover:-translate-y-0.5 sm:inline-flex"
        >Contact us</a
      >
      <button
        id="menu-toggle"
        type="button"
        class="relative z-10 inline-flex size-11 items-center justify-center rounded-full border border-white/25 text-white group-data-[state=scrolled]/header:border-line group-data-[state=scrolled]/header:text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Open menu</span>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"
          ><path d="M2 6h16M2 14h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg
        >
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    hidden
    class="fixed inset-0 z-40 flex flex-col bg-green-950 px-6 pb-10 pt-28 text-white lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
  >
    <button id="menu-close" type="button" class="absolute right-5 top-5 inline-flex size-11 items-center justify-center rounded-full border border-white/25">
      <span class="sr-only">Close menu</span>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"
        ><path d="M3 3l12 12M15 3L3 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg
      >
    </button>
    <ul class="space-y-1">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="block py-2 font-display text-4xl">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/contact-us" class="mt-auto inline-flex justify-center rounded-full bg-lime px-6 py-4 font-semibold text-green-950">Contact us</a>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const update = () => (header.dataset.state = window.scrollY > 24 ? 'scrolled' : 'top');
  update();
  window.addEventListener('scroll', update, { passive: true });

  const menu = document.getElementById('mobile-menu')!;
  const open = document.getElementById('menu-toggle')!;
  const close = document.getElementById('menu-close')!;
  const setOpen = (v: boolean) => {
    menu.hidden = !v;
    open.setAttribute('aria-expanded', String(v));
    document.body.style.overflow = v ? 'hidden' : '';
    (v ? close : open).focus();
  };
  open.addEventListener('click', () => setOpen(true));
  close.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && !menu.hidden && setOpen(false));
</script>
