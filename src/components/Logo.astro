---
/**
 * Mahela logo: the blue elephant emblem (from the client's WordPress library)
 * with a type wordmark. No vector logo exists yet; swap in an SVG when supplied.
 */
import { Image } from 'astro:assets';
import emblem from '../assets/media/brand/mahela-emblem-hires.png';

interface Props {
  tone?: 'brand' | 'light';
  class?: string;
}
const { tone = 'brand', class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-3', className]}>
  <Image src={emblem} alt="" width={96} height={89} class="h-10 w-auto" loading="eager" />
  <span class:list={['leading-none', tone === 'light' ? 'text-white' : 'text-brand']}>
    <span class="block font-sans text-[1.15rem] font-extrabold tracking-[0.08em]">MAHELA</span>
    <span class="eyebrow block pt-1 text-[0.55rem] tracking-[0.5em] opacity-80">Group</span>
  </span>
</span>
