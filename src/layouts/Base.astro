---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { site } from '../data/site';
import { media } from '../lib/media';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown>[];
  chrome?: boolean;
  noindex?: boolean;
  breadcrumbs?: { name: string; href: string }[];
  ogImage?: ImageMetadata;
  type?: 'website' | 'article';
}

const { title, description = site.description, jsonLd = [], chrome = true, noindex = false, breadcrumbs = [], ogImage, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Citrus producers and exporters, Limpopo, South Africa`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const og = await getImage({ src: ogImage ?? media('farms/dsc-1739.jpg'), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
const ogUrl = new URL(og.src, site.url).toString();

const organization = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${site.url}/#organization`,
  name: site.name,
  legalName: 'Mahela Group',
  url: site.url,
  logo: `${site.url}/favicon.svg`,
  image: ogUrl,
  description: site.description,
  foundingDate: '1942',
  foundingLocation: 'The Junction, Letsitele, Limpopo, South Africa',
  email: site.email,
  telephone: site.phone,
  faxNumber: site.fax,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: -23.8786, longitude: 30.3925 },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '17:00' }],
  numberOfEmployees: { '@type': 'QuantitativeValue', value: 700 },
  areaServed: ['Europe', 'Asia', 'Japan', 'Middle East', 'Far East', 'Russia', 'South Africa'],
  knowsAbout: ['Citrus production', 'Citrus export', 'Grapefruit', 'Valencia oranges', 'Soft citrus', 'Lemons', 'Avocados', 'Bananas', 'Macadamias', 'Litchis', 'Golden kiwis', 'GlobalGAP', 'Cold chain'],
  brand: [
    { '@type': 'Brand', name: 'Makulu Citrus' },
    { '@type': 'Brand', name: 'Mahela Boerdery' },
    { '@type': 'Brand', name: 'Mala-Mala Citrus' },
  ],
  hasCredential: [
    { '@type': 'EducationalOccupationalCredential', name: 'GlobalGAP certified (since 2003)' },
    { '@type': 'EducationalOccupationalCredential', name: 'SIZA accredited' },
  ],
  sameAs: [site.social.facebook, site.social.x],
};
const crumbs = breadcrumbs.length
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: new URL(b.href, site.url).toString(),
        })),
      },
    ]
  : [];
const schemas = [organization, ...crumbs, ...jsonLd];
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#10201a" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Mahela_Group" />
    <meta name="geo.region" content="ZA-LP" />
    <meta name="geo.placename" content="Letsitele" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion');
      }
    </script>
  </head>
  <body class="min-h-screen overflow-x-clip font-sans text-ivory antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-lime focus:px-4 focus:py-2 focus:text-green-950">Skip to content</a>
    {chrome && <Header />}
    <main id="main" class="relative isolate">
      <slot />
    </main>
    {chrome && <Footer />}
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
