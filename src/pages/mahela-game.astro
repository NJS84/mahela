---
import Base from '../layouts/Base.astro';
import PageHero from '../components/site/PageHero.astro';
import Backdrop from '../components/site/Backdrop.astro';
import SectionTitle from '../components/site/SectionTitle.astro';
import Gallery from '../components/site/Gallery.astro';
import CtaBand from '../components/site/CtaBand.astro';
import { media } from '../lib/media';
import { game } from '../data/pages';

const description = 'Mahela Game breeds rarer game species such as sable and roan to conserve and improve their genetics, in partnership with BJ Vorster and Benchmark Game Breeders in Limpopo.';
---

<Base title="Mahela Game" description={description} breadcrumbs={[{ name: 'Mahela Game', href: '/mahela-game' }]} ogImage={media('conservation/dsc-1615.jpg')}>
  <PageHero image={media('conservation/dsc-1615.jpg')} eyebrow="Mahela Game" title="Conserving rare game genetics" lead={game.lead} crumbs={[{ name: 'Mahela Game', href: '/mahela-game' }]} />

  <Backdrop image={media('conservation/dsc-0526.jpg')} dim={0.66}>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="glass rounded-[32px] p-8 md:p-12 lg:col-span-7" data-reveal data-glare>
        <SectionTitle eyebrow="Breeding programme" title="Game breeding at Mahela" id="game-title" />
        {game.body.map((b) => <p class="mt-5 leading-relaxed text-ivory/85">{b}</p>)}
      </div>
      <div class="lg:col-span-5">
        <div class="glass rounded-[32px] p-8" data-reveal>
          <h2 class="cond text-sm font-semibold uppercase tracking-[0.18em] text-sage">Species we breed and conserve</h2>
          <ul class="mt-6 flex flex-wrap gap-2">
            {game.species.map((s) => <li class="glass-soft rounded-full px-4 py-2 text-sm font-medium transition-colors hover:bg-ivory/20">{s}</li>)}
          </ul>
        </div>
        <div class="glass mt-5 rounded-[32px] p-8" data-reveal>
          <p class="cond text-6xl font-semibold text-sage">1998</p>
          <p class="mt-2 text-ivory/80">Mahela co-founded a sable breeding project as part of the Gravelotte Study Group.</p>
        </div>
      </div>
    </div>
  </Backdrop>

  <section class="mx-auto max-w-[84rem] px-4 py-24 md:px-6 md:py-32" aria-labelledby="wild-title">
    <SectionTitle eyebrow="Wildlife on Mahela farms" title="Custodians of nature" lead="Mahela plays an active role in the conservation of wildlife. Game species such as the African wild dog and sable are some of the species we have helped to protect." id="wild-title" />
    <div class="mt-12 pb-10">
      <Gallery images={[
        { src: 'conservation/dsc-8959.jpg', alt: 'An African wild dog on a Mahela farm' },
        { src: 'conservation/dsc-0526.jpg', alt: 'A pack of African wild dogs resting' },
        { src: 'conservation/buffel1.jpg', alt: 'Buffalo on a Mahela game farm' },
      ]} />
    </div>
    <div class="mt-16"><CtaBand title="Enquire about Mahela Game." text="Contact the Mahela team about game breeding and the Benchmark Game Breeders auction." /></div>
  </section>
</Base>
