---
/**
 * Home. Glass design (locked Phase 2): full-screen hero film, 3D orange,
 * pinned produce rail, farm-to-port journey, export globe, heritage timeline.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/site/Icon.astro';
import SectionTitle from '../components/site/SectionTitle.astro';
import Backdrop from '../components/site/Backdrop.astro';
import Figures from '../components/site/Figures.astro';
import ProduceCard from '../components/site/ProduceCard.astro';
import Journey from '../components/site/Journey.astro';
import ExportGlobe from '../components/site/ExportGlobe.astro';
import Heritage from '../components/site/Heritage.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Leaves from '../components/site/Leaves.astro';
import { site, hero, intro, produce, process, compliance, people } from '../data/site';
import { posts } from '../data/pages';
import { produceArt, produceIcon } from '../data/produce-art';
import { media } from '../lib/media';
import heroImage from '../assets/media/video/hero-poster.jpg';

/** Hero loop cut from Mahela_MASTER_GRADED_1-001.mp4 (19 s, muted). */
const heroVideo = { desktop: '/video/hero-1280.mp4', mobile: '/video/hero-960.mp4' };

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  inLanguage: 'en-ZA',
  publisher: { '@id': `${site.url}/#organization` },
};

const badges = [
  { icon: 'leaf', label: 'GlobalGAP', sub: 'since 2003' },
  { icon: 'people', label: 'SIZA', sub: 'accredited' },
  { icon: 'shield', label: 'PPECB', sub: 'inspected' },
] as const;

const citrusGroups = ['Grapefruit', 'Valencia oranges', 'Navels', 'Soft citrus', 'Lemons'];

const figures = [
  { value: 1942, label: 'Founded', note: 'The Junction, Letsitele', format: 'year' as const },
  { value: 700, label: 'Full-time jobs', note: 'Plus 1 100 non-permanent' },
  { value: 20000, label: 'Packhouse area', note: 'm², Junction and Ohrigstad' },
  { value: 1200, label: 'Tons a day', note: 'In season, double shifts', prefix: 'Up to' },
];

const pillarIcons = ['leaf', 'people', 'flask', 'box'] as const;
const certs = ['certifications/globalgap-colour.png', 'certifications/siza-colour.png', 'certifications/nsf-registered-colour.png'];
const latest = posts.slice(0, 3);
const fmtDate = (d: string) => new Date(d).toLocaleDateString('en-ZA', { year: 'numeric', month: 'long' });
---

<Base jsonLd={[website]} description="Mahela Group is a 4th generation, GlobalGAP-certified grower and exporter of premium citrus, avocados, bananas, macadamias, litchis and golden kiwis from Letsitele in Limpopo, South Africa.">
  <!-- Hero -->
  <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden" aria-labelledby="g-hero">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute inset-0" data-hero-media>
        <Image src={heroImage} alt="" widths={[768, 1280]} sizes="100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
        <video class="absolute inset-0 h-full w-full object-cover" autoplay muted loop playsinline preload="auto" data-hero-video>
          <source src={heroVideo.mobile} type="video/mp4" media="(max-width: 767px)" />
          <source src={heroVideo.desktop} type="video/mp4" />
        </video>
      </div>
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(12_26_22/0.45)_0%,rgb(12_26_22/0.15)_35%,rgb(12_26_22/0.75)_100%)]"></div>
    </div>
    <div class="mx-auto w-full max-w-[84rem] px-4 pb-14 pt-32 md:px-6 md:pb-20">
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.24em] text-ivory/80">{hero.eyebrow}</p>
      <h1 id="g-hero" class="cond max-w-4xl text-[clamp(3.4rem,2rem+6.5vw,7.25rem)] font-medium uppercase leading-[0.9] tracking-[0.01em] drop-shadow-[0_4px_30px_rgba(0,0,0,0.35)]" data-split>
        Premium citrus.<br />Ready for<br /><span class="text-sage">the world.</span>
      </h1>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/contact-us" class="btn-forest inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.12em]" data-magnetic>{hero.primary.label} <Icon name="arrow" class="size-4" /></a>
        <a href="/produce" class="glass inline-flex items-center rounded-full px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.12em]" data-magnetic>Our produce</a>
      </div>
      <ul class="glass mt-8 grid grid-cols-3 divide-x divide-ivory/15 rounded-[22px] py-4 md:hidden" aria-label="Certifications">
        {
          badges.map((b) => (
            <li class="flex flex-col items-center px-2 text-center">
              <Icon name={b.icon} class="size-5" />
              <span class="cond mt-1.5 text-sm font-semibold uppercase tracking-[0.08em]">{b.label}</span>
              <span class="text-[0.65rem] uppercase tracking-[0.12em] text-ivory/65">{b.sub}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <ul class="glass absolute right-4 top-1/2 hidden -translate-y-1/2 flex-col rounded-[22px] px-3 py-4 md:right-6 md:flex xl:right-[max(1.5rem,calc((100vw-84rem)/2+1.5rem))]" aria-label="Certifications">
      {
        badges.map((b, i) => (
          <li class:list={['flex w-24 flex-col items-center py-3 text-center', i > 0 && 'border-t border-ivory/15']} data-badge>
            <span class="flex size-12 items-center justify-center rounded-full border border-ivory/35 bg-ivory/5"><Icon name={b.icon} class="size-5" /></span>
            <span class="cond mt-2 text-sm font-semibold uppercase tracking-[0.08em]">{b.label}</span>
            <span class="text-[0.7rem] uppercase tracking-[0.12em] text-ivory/65">{b.sub}</span>
          </li>
        ))
      }
    </ul>
    <span class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-[0.65rem] uppercase tracking-[0.3em] text-ivory/60 md:flex" aria-hidden="true">
      Scroll<span class="h-10 w-px animate-pulse bg-ivory/50"></span>
    </span>
  </section>

  <!-- Intro + 3D orange -->
  <section class="relative isolate overflow-hidden" aria-labelledby="g-intro">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <Image src={media('farms/dsc-7988.jpg')} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="h-full w-full object-cover object-[50%_60%]" />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgb(12_26_22/0.86)_0%,rgb(12_26_22/0.5)_60%,rgb(12_26_22/0.4)_100%)]"></div>
    </div>
    <Leaves spots={[{ x: '46%', y: '8%', size: 80, r: -20 }, { x: '92%', y: '70%', size: 120, r: 60, blur: true }, { x: '3%', y: '86%', size: 70, r: 140 }]} />
    <div class="relative z-10 mx-auto grid min-h-[100svh] max-w-[84rem] items-center gap-10 px-4 py-24 md:px-6 lg:grid-cols-12">
      <div class="glass rounded-[28px] p-7 md:p-10 lg:col-span-6" data-reveal data-glare>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sage">{intro.eyebrow}</p>
        <h2 id="g-intro" class="cond mt-4 text-[clamp(2rem,1.4rem+2vw,3.1rem)] font-medium uppercase leading-[1] tracking-[0.02em]">Four generations on the same Lowveld soil</h2>
        <div class="leaf-rule my-6 max-w-[12rem]"><Icon name="leaf" class="size-4" /></div>
        <p class="text-lg leading-relaxed text-ivory/90">{hero.lead}</p>
        <p class="mt-4 leading-relaxed text-ivory/75">{intro.support}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/about-us" class="glass-soft inline-flex rounded-full px-6 py-3 text-xs font-semibold uppercase tracking-[0.16em]">About Mahela</a>
          <a href="/produce/citrus" class="inline-flex items-center gap-2 rounded-full px-2 py-3 text-xs font-semibold uppercase tracking-[0.16em] text-sage">Our citrus <Icon name="arrow" class="size-4" /></a>
        </div>
      </div>
      <div class="relative lg:col-span-6">
        <div class="relative mx-auto aspect-square w-full max-w-[560px]" data-orange3d>
          <Image src={media(produceArt.citrus!)} alt="A Mahela orange with leaves" widths={[360, 540]} sizes="(min-width: 1024px) 480px, 80vw" class="orange-fallback absolute inset-[10%] h-[80%] w-[80%] object-contain drop-shadow-[0_30px_50px_rgba(0,0,0,0.45)]" />
          <ul class="orange-labels pointer-events-none absolute inset-0" aria-label="Mahela citrus groups">
            {citrusGroups.map((g, i) => <li class="orange-label cond glass-soft absolute rounded-full px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.12em]" style={`--i:${i}`}>{g}</li>)}
          </ul>
        </div>
        <p class="hint mt-2 flex items-center justify-center gap-2 text-xs uppercase tracking-[0.18em] text-ivory/60"><Icon name="sun" class="size-4" />Drag to turn · scroll to open</p>
      </div>
    </div>
  </section>

  <!-- Figures -->
  <Backdrop image={media('farms/dsc-1779.jpg')} dim={0.58}>
    <section class="glass rounded-[32px] p-8 md:p-12" aria-labelledby="g-figures" data-reveal data-glare>
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-4">
          <h2 id="g-figures" class="cond text-[clamp(1.9rem,1.3rem+1.8vw,2.8rem)] font-medium uppercase leading-[1] tracking-[0.03em]">One of South Africa’s biggest privately-owned citrus exporters.</h2>
          <p class="mt-5 leading-relaxed text-ivory/80">Fully GlobalGAP certified since 2003, with two state-of-the-art packhouses in Limpopo.</p>
          <a href="/packhouses" class="btn-blue mt-7 inline-flex rounded-full px-6 py-3 text-xs font-semibold uppercase tracking-[0.16em]">Packhouse capability</a>
        </div>
        <div class="lg:col-span-8"><Figures items={figures} /></div>
      </div>
    </section>
  </Backdrop>

  <!-- Produce rail -->
  <section class="relative overflow-hidden" aria-labelledby="g-produce" data-rail>
    <div class="absolute inset-0 -z-10 bg-[#1e4a30] transition-colors" data-rail-tint></div>
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(80%_60%_at_70%_40%,rgb(255_255_255/0.14),transparent_70%)]"></div>
    <Leaves spots={[{ x: '84%', y: '10%', size: 110, r: 30, blur: true }, { x: '40%', y: '86%', size: 70, r: -60 }]} />
    <div class="flex min-h-[100svh] flex-col justify-center py-24 lg:py-16">
      <div class="mx-auto w-full max-w-[84rem] px-4 md:px-6">
        <SectionTitle eyebrow="Mahela produce" title="A diversified fruit portfolio. Citrus at the core." lead="Tried-and-tested orchard management and the Lowveld’s warm days and cool nights support fruit with balanced sugar and acidity, good fibre and moisture, and the consistency international buyers expect." id="g-produce" />
      </div>
      <div class="mt-12 snap-x snap-mandatory overflow-x-auto pb-6 lg:overflow-visible lg:pb-0">
        <ul class="flex w-max gap-8 px-4 md:px-[max(1.5rem,calc((100vw-84rem)/2+1.5rem))] lg:gap-14" data-rail-track>
          {
            produce.map((p) => (
              <li class="w-[82vw] max-w-[26rem] shrink-0 snap-center lg:w-[26rem]" data-rail-card data-tone={p.tone[1]}>
                <ProduceCard
                  tag={p.tag}
                  title={p.name}
                  href={`/produce/${p.slug}`}
                  image={media(produceArt[p.slug]!)}
                  icon={produceIcon[p.slug]}
                  points={p.facts.slice(0, 3)}
                  accent={p.tone[0]}
                />
              </li>
            ))
          }
          <li class="flex w-[60vw] max-w-[18rem] shrink-0 items-center lg:w-[18rem]">
            <a href="/produce" class="btn-forest rounded-full px-6 py-3.5 text-xs font-semibold uppercase tracking-[0.16em]">All produce</a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Process journey -->
  <Backdrop image={media('farms/dhk-8632.jpg')} dim={0.7}>
    <SectionTitle eyebrow={process.eyebrow} title={process.title} lead={process.lead} align="center" id="g-process" />
    <div class="mt-16">
      <Journey steps={process.steps.map((s, i) => ({ ...s, icon: (['sprout', 'leaf', 'sun', 'drop', 'globe'] as const)[i] }))} />
    </div>
  </Backdrop>

  <!-- Compliance -->
  <Backdrop image={media('packhouse/dsc-1871.jpg')} dim={0.66}>
    <section aria-labelledby="g-compliance">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7"><SectionTitle eyebrow={compliance.eyebrow} title={compliance.title} lead={compliance.lead} id="g-compliance" /></div>
        <ul class="flex flex-wrap items-center gap-3 lg:col-span-5 lg:justify-end" aria-label="Certifications" data-reveal>
          {certs.map((c) => <li class="rounded-2xl bg-ivory/90 px-4 py-3"><Image src={media(c)} alt={c.includes('globalgap') ? 'GlobalGAP' : c.includes('siza') ? 'SIZA' : 'NSF Registered'} height={44} class="h-10 w-auto" /></li>)}
        </ul>
      </div>
      <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          compliance.pillars.map((p, i) => (
            <li class="glass flex flex-col rounded-[26px] p-7" data-reveal data-tilt data-glare>
              <span class="flex size-12 items-center justify-center rounded-full border border-ivory/30 bg-forest/50"><Icon name={pillarIcons[i]!} class="size-6" /></span>
              <h3 class="cond mt-5 text-xl font-medium uppercase tracking-[0.05em]">{p.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-ivory/80">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </Backdrop>

  <!-- Export globe -->
  <section class="relative overflow-hidden bg-[radial-gradient(70%_60%_at_70%_50%,#163a29,#0c1c15)] py-24 md:py-32">
    <div class="mx-auto max-w-[84rem] px-4 md:px-6"><ExportGlobe /></div>
  </section>

  <!-- Heritage -->
  <div class="relative">
    <div class="sticky top-0 -z-10 -mb-[100svh] h-[100svh] overflow-hidden" aria-hidden="true">
      <Image src={media('farms/dsc-1689.jpg')} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-[rgb(12_26_22/0.68)]"></div>
    </div>
    <Heritage />
  </div>

  <!-- People + news + CTA -->
  <Backdrop image={media('people/dhk-9884.jpg')} dim={0.64}>
    <section class="grid gap-8 lg:grid-cols-12 lg:items-stretch" aria-labelledby="g-people">
      <div class="glass rounded-[32px] p-8 md:p-12 lg:col-span-7" data-reveal data-glare>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sage">{people.eyebrow}</p>
        <h2 id="g-people" class="cond mt-3 text-[clamp(2rem,1.3rem+2.4vw,3.4rem)] font-medium uppercase leading-[0.98]">{people.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-ivory/85">{people.text}</p>
        <a href={people.cta.href} class="btn-forest mt-8 inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-xs font-semibold uppercase tracking-[0.16em]" data-magnetic>{people.cta.label}<Icon name="arrow" class="size-4" /></a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1">
        <div class="glass-dark flex flex-col justify-center rounded-[28px] p-7" data-reveal><span class="cond text-5xl font-semibold tabular" data-count="700">700</span><span class="mt-2 text-sm uppercase tracking-[0.14em] text-ivory/70">Full-time employees</span></div>
        <div class="glass-dark flex flex-col justify-center rounded-[28px] p-7" data-reveal><span class="cond text-5xl font-semibold tabular" data-count="1100">1 100</span><span class="mt-2 text-sm uppercase tracking-[0.14em] text-ivory/70">Additional non-permanent jobs</span></div>
      </div>
    </section>

    <section class="mt-24" aria-labelledby="g-news">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionTitle eyebrow="In the news" title="Mahela in the press" id="g-news" />
        <a href="/news" class="glass-soft rounded-full px-6 py-3 text-xs font-semibold uppercase tracking-[0.16em]">All news</a>
      </div>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          latest.map((p) => (
            <li class="glass group overflow-hidden rounded-[26px]" data-reveal data-glare>
              <a href={`/news/${p.slug}`} class="flex h-full flex-col">
                {p.image && (
                  <span class="block aspect-[16/10] overflow-hidden">
                    <Image src={media(p.image)} alt="" widths={[480, 720]} sizes="(min-width: 768px) 30vw, 90vw" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                  </span>
                )}
                <span class="flex flex-1 flex-col p-6">
                  <span class="text-xs uppercase tracking-[0.16em] text-ivory/60">{fmtDate(p.date)}{p.source && ` · ${p.source}`}</span>
                  <span class="cond mt-3 text-xl font-medium leading-snug">{p.title}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-24"><CtaBand /></div>
  </Backdrop>
</Base>

<style>
  /* 3D orange: labels fan out around the segments as it splits (--split 0..1). */
  [data-orange3d] {
    --split: 0;
    container-type: inline-size;
  }
  .orange-label {
    left: 50%;
    top: 50%;
    opacity: 0;
    transform: translate(-50%, -50%);
    white-space: nowrap;
  }
  [data-orange3d]:global(.is-3d) .orange-fallback {
    display: none;
  }
  [data-orange3d]:global(.is-3d) .orange-label {
    opacity: calc(var(--split) * 1.4 - 0.4);
    transform: translate(-50%, -50%) translate(calc(cos(var(--i) * 72deg - 90deg) * var(--split) * 34cqw), calc(sin(var(--i) * 72deg - 90deg) * var(--split) * 38cqw));
  }
  .hint {
    visibility: hidden;
  }
  :global(.js-motion) .hint {
    visibility: visible;
  }
</style>

<script>
  // Respect reduced motion: hold the hero film on its poster frame.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay');
    video.pause();
  }
</script>
