---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/site/PageHero.astro';
import Backdrop from '../../components/site/Backdrop.astro';
import SectionTitle from '../../components/site/SectionTitle.astro';
import FactList from '../../components/site/FactList.astro';
import Gallery from '../../components/site/Gallery.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import Leaves from '../../components/site/Leaves.astro';
import Icon from '../../components/site/Icon.astro';
import CitrusBurst from '../../components/site/CitrusBurst.astro';
import CitrusVarieties from '../../components/site/CitrusVarieties.astro';
import CitrusOrchards from '../../components/site/CitrusOrchards.astro';
import AvocadoVarieties from '../../components/site/AvocadoVarieties.astro';
import AvocadoSplit from '../../components/site/AvocadoSplit.astro';
import PhotoMosaic from '../../components/site/PhotoMosaic.astro';
import BananaStory from '../../components/site/BananaStory.astro';
import BananaRipen from '../../components/site/BananaRipen.astro';
import MacadamiaStory from '../../components/site/MacadamiaStory.astro';
import MacadamiaRoute from '../../components/site/MacadamiaRoute.astro';
import { media } from '../../lib/media';
import { produceDetail } from '../../data/pages';
import { produce } from '../../data/site';
import { produceArt, citrusArt } from '../../data/produce-art';

export function getStaticPaths() {
  return Object.keys(produceDetail).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: string };
const p = produceDetail[slug]!;
const idx = produce.findIndex((x) => x.slug === slug);
const next = produce[(idx + 1) % produce.length]!;
const isCitrus = slug === 'citrus';
const isAvo = slug === 'avocados';
const isBanana = slug === 'bananas';
const isMac = slug === 'macadamias';
const hero = media(p.hero);
const sibling = isCitrus || isAvo || isBanana || isMac;
/** Avocado farm photography (Mahela fotos 2022 and 2025 Avos shoots). */
const avoTiles = [
  { src: 'produce/farm/avocado-harvest-bin-105260.jpg', alt: 'Freshly picked avocados tipped from crates into a bin on a tractor trailer in a Mahela orchard', cls: 'sm:col-span-2 lg:col-span-4 lg:row-span-2' },
  { src: 'produce/farm/avocado-on-tree-105272.jpg', alt: 'Avocados hanging among the leaves on a Mahela tree', cls: 'lg:col-span-2 lg:row-span-2' },
  { src: 'produce/farm/avocado-picking-pole-103359.jpg', alt: 'A picking pole with its cloth bag catching an avocado from high in the tree', cls: 'lg:col-span-2' },
  { src: 'produce/farm/avocado-picker-103362.jpg', alt: 'A Mahela picker with a net bag of avocados in the orchard', cls: 'lg:col-span-2' },
  { src: 'produce/farm/avocado-worker-105252.jpg', alt: 'A smiling Mahela farm worker holding freshly picked avocados', cls: 'sm:col-span-2 lg:col-span-2' },
  { src: 'produce/farm/avocado-new-orchard-105562.jpg', alt: 'A young avocado orchard planted on the hills, with mountains behind', cls: 'sm:col-span-2 lg:col-span-6' },
];
/** Banana farm photography (Mahela fotos 2022, Piesangs). */
const bananaTiles = [
  { src: 'produce/farm/banana-canopy-105231.jpg', alt: 'Looking up through the leaves of a Mahela banana plantation at a young bunch and its flower', cls: 'sm:col-span-2 lg:col-span-4 lg:row-span-2' },
  { src: 'produce/farm/banana-bunch-on-plant-105215.jpg', alt: 'A bunch of green Cavendish bananas growing on the plant', cls: 'lg:col-span-2 lg:row-span-2' },
  { src: 'produce/farm/banana-flower-opened-105223.jpg', alt: 'A banana flower opened by hand to show the tiny fruit forming inside', cls: 'lg:col-span-2' },
  { src: 'produce/farm/banana-bunch-flower-105229.jpg', alt: 'A banana bunch with its purple flower hanging beneath the leaves', cls: 'lg:col-span-2' },
  { src: 'produce/farm/banana-bagged-rows-105232.jpg', alt: 'Rows of banana plants with their bunches covered in blue bags along a red-soil road', cls: 'sm:col-span-2 lg:col-span-2' },
  { src: 'produce/farm/banana-young-rows-105235.jpg', alt: 'Neat rows of young banana plants on red soil, with trees on the hill behind', cls: 'sm:col-span-2 lg:col-span-6' },
];
/** Macadamia photography (Mahela Elements stock shots and the original site photos). */
const macTiles = [
  { src: 'produce/farm/macadamia-burlap-sack.jpg', alt: 'Freshly harvested macadamia nuts in shell spilling from a burlap sack', cls: 'lg:col-span-2 lg:row-span-2' },
  { src: 'produce/farm/macadamia-kernel-spoon-b.jpg', alt: 'Cream-coloured macadamia kernels heaped on a wooden spoon', cls: 'sm:col-span-2 lg:col-span-4 lg:row-span-2' },
  { src: 'produce/photos/mahela-aug28.jpg', alt: 'Macadamia nuts in shell in a bowl and scattered on a white table', cls: 'lg:col-span-3' },
  { src: 'produce/photos/img-9307.jpg', alt: 'A close view of whole macadamia kernels', cls: 'lg:col-span-3' },
];
// The citrus burst below already features a whole orange, so the intro shows orange blossom instead.
const art = media(isCitrus ? 'produce/renders/citrus-blossom.webp' : produceArt[slug]!);
const url = `https://www.mahela.co.za/produce/${slug}`;
const varietyNames = (p.groups ?? []).flatMap((g) => g.varieties.map((v) => v.name));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${url}#product`,
    name: `${p.title} from Mahela Group`,
    description: p.description,
    url,
    category: slug === 'macadamias' ? 'Nuts' : 'Fresh fruit',
    brand: { '@type': 'Brand', name: 'Mahela Group' },
    manufacturer: { '@id': 'https://www.mahela.co.za/#organization' },
    countryOfOrigin: { '@type': 'Country', name: 'South Africa' },
    additionalProperty: p.facts.map((f) => ({ '@type': 'PropertyValue', name: f.label, value: f.value })),
    ...(varietyNames.length ? { model: varietyNames.map((n) => ({ '@type': 'ProductModel', name: n })) } : {}),
  },
];
---

<Base title={p.metaTitle} description={p.description} breadcrumbs={[{ name: 'Produce', href: '/produce' }, { name: p.title, href: `/produce/${slug}` }]} jsonLd={jsonLd} ogImage={hero}>
  <PageHero image={hero} eyebrow="Mahela produce" title={p.title} lead={p.description} crumbs={[{ name: 'Produce', href: '/produce' }, { name: p.title, href: `/produce/${slug}` }]}>
    {
      isBanana && (
        <div slot="beside" class="mm-card shrink-0 rounded-[18px] p-2 md:rounded-[26px] md:p-3" data-reveal>
          <Image src={media('brand/mala-mala-logo.png')} alt="Mala-Mala, the brand Mahela bananas are sold under" widths={[320, 480]} sizes="(min-width: 768px) 15rem, 8rem" class="block h-auto w-32 rounded-[12px] sm:w-44 md:w-60 md:rounded-[18px]" />
        </div>
      )
    }
  </PageHero>

  <section class="relative overflow-hidden py-24 md:py-32" style={`--accent:${p.accent}`} aria-labelledby="answer-title">
    <div class="absolute inset-0 -z-10" style="background: radial-gradient(60% 50% at 80% 30%, color-mix(in srgb, var(--accent) 35%, transparent), transparent 70%), #10201a"></div>
    <Leaves />
    <div class="relative mx-auto grid max-w-[84rem] items-center gap-12 px-4 md:px-6 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionTitle eyebrow={`About our ${p.title.toLowerCase()}`} title={`Mahela ${p.title.toLowerCase()}, grown in Limpopo`} id="answer-title" />
        <p class="mt-6 text-xl leading-relaxed text-ivory/90" data-reveal>{p.answer}</p>
        {!isBanana && p.body.map((b) => <p class="mt-5 leading-relaxed text-ivory/75" data-reveal>{b}</p>)}
        <div class="mt-10"><FactList facts={p.facts} variant={sibling ? 'blue' : 'default'} /></div>
      </div>
      <div class="relative lg:col-span-5" aria-hidden="true">
        <div class="absolute inset-[15%] rounded-full blur-3xl" style="background: color-mix(in srgb, var(--accent) 55%, transparent)"></div>
        <div data-parallax="-0.25">
          <Image src={art} alt="" widths={[420, 640]} sizes="(min-width: 1024px) 36vw, 80vw" class="relative mx-auto w-[80%] drop-shadow-[0_40px_50px_rgba(0,0,0,0.5)] lg:w-full" data-float-big />
        </div>
      </div>
    </div>
  </section>

  {isCitrus && <CitrusBurst />}
  {isCitrus && <CitrusVarieties />}
  {isAvo && <AvocadoVarieties />}
  {isAvo && <AvocadoSplit />}
  {isBanana && <BananaStory />}
  {isBanana && <BananaRipen />}
  {isMac && <MacadamiaStory />}
  {isMac && <MacadamiaRoute />}

  {
    !sibling && p.groups && p.groups.length > 0 && (
      <Backdrop image={media(p.gallery[0] ?? p.hero)} dim={0.72}>
        <SectionTitle eyebrow="Varieties" title={`${p.title} varieties`} id="varieties-title" />
        <div class="mt-14 space-y-16">
          {p.groups.map((g) => {
            const gArt = slug === 'citrus' ? citrusArt[g.group as keyof typeof citrusArt] : undefined;
            return (
              <section aria-label={g.group} class="grid gap-8 lg:grid-cols-12">
                {p.groups!.length > 1 && (
                  <div class="flex items-center gap-5 lg:col-span-3 lg:flex-col lg:items-start">
                    {gArt && <Image src={media(gArt)} alt="" width={200} height={200} class="size-24 object-contain drop-shadow-[0_16px_20px_rgba(0,0,0,0.4)] lg:size-36" data-reveal />}
                    <h3 class="cond text-3xl font-medium uppercase tracking-[0.04em]" data-reveal>{g.group}</h3>
                  </div>
                )}
                <ul class:list={['grid gap-4 sm:grid-cols-2', p.groups!.length > 1 ? 'lg:col-span-9' : 'lg:col-span-12 lg:grid-cols-3']}>
                  {g.varieties.map((v) => (
                    <li class="glass rounded-[24px] p-6 transition-transform duration-500 hover:-translate-y-1" data-reveal data-glare>
                      <h4 class="cond text-xl font-semibold uppercase tracking-[0.06em]">{v.name}</h4>
                      <p class="mt-2 text-[0.95rem] leading-relaxed text-ivory/80">{v.text}</p>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })}
        </div>
      </Backdrop>
    )
  }

  <section class="mx-auto max-w-[84rem] px-4 py-24 md:px-6 md:py-32" aria-labelledby="gallery-title">
    <SectionTitle eyebrow={isMac ? 'In shell and kernel' : 'On the farm'} title={`${p.title} at Mahela`} id="gallery-title" />
    <div class="mt-12 pb-10">
      {isCitrus ? <CitrusOrchards /> : isAvo ? <PhotoMosaic tiles={avoTiles} /> : isBanana ? <PhotoMosaic tiles={bananaTiles} /> : isMac ? <PhotoMosaic tiles={macTiles} /> : <Gallery images={[p.hero, ...p.gallery].slice(0, 4).map((src, i) => ({ src, alt: `${p.title} on a Mahela Group farm in Limpopo, photo ${i + 1}` }))} />}
    </div>
    <a href={`/produce/${next.slug}`} class="glass group mt-16 flex items-center justify-between gap-6 rounded-[28px] p-6 md:p-8" data-glare>
      <span>
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-sage">Next</span>
        <span class="cond mt-1 block text-3xl font-medium uppercase md:text-5xl">{next.name}</span>
      </span>
      <span class="flex items-center gap-4">
        <Image src={media(produceArt[next.slug]!)} alt="" width={140} height={140} class="size-20 object-contain transition-transform duration-700 group-hover:-rotate-12 group-hover:scale-110 md:size-28" />
        <Icon name="arrow" class="size-6 transition-transform group-hover:translate-x-1" />
      </span>
    </a>
    <div class="mt-16"><CtaBand /></div>
  </section>
</Base>

<style>
  /* Mala-Mala logo on frosted blue glass beside the bananas heading: mostly opaque so the label reads cleanly. */
  .mm-card {
    background: linear-gradient(160deg, rgb(214 230 250 / 0.55), rgb(150 182 222 / 0.38));
    border: 1px solid rgb(235 244 255 / 0.6);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.55),
      0 30px 60px -24px rgb(0 0 0 / 0.55);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    backdrop-filter: blur(20px) saturate(150%);
  }
</style>
